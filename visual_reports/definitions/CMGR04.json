{
  "CMGR04REPORT": {
    "REPORT": {
      "schema_version": 1,
      "name": "CMGR04",
      "title": "Groups - Attendance Sheet",
      "dataset": "churchmanager.cmgr04",
      "datasetversion": 1,
      "pagesize": "letter",
      "orientation": "landscape",
      "margins": {"top": 30, "right": 36, "bottom": 30, "left": 36},
      "theme": "churchmanager.standard",
      "emptytext": "No records match the selected criteria.",
      "bands": {
        "ReportHeader": {"type": "reportheader", "height": 92},
        "PageHeader": {"type": "pageheader", "height": 8, "repeat": true},
        "Detail": {"type": "detail", "height": 190},
        "PageFooter": {"type": "pagefooter", "height": 24, "repeat": true}
      },
      "sort": [
        {"collection": "records", "field": "LastName", "direction": "ascending"},
        {"collection": "records", "field": "FirstName", "direction": "ascending"}
      ]
    },
    "CONTROLS": {
      "ChurchLogo": {
        "type": "image", "band": "ReportHeader", "position": [0, 0], "size": [62, 62],
        "collection": "church", "field": "Logo"
      },
      "ChurchName": {
        "type": "text", "band": "ReportHeader", "position": [72, 2], "size": [648, 22],
        "collection": "church", "field": "Church", "fontsize": 15, "bold": true, "align": "center"
      },
      "ReportTitle": {
        "type": "systemtext", "band": "ReportHeader", "position": [72, 29], "size": [648, 20],
        "systemvalue": "report_title", "fontsize": 13, "bold": true, "align": "center"
      },
      "Parameters": {
        "type": "text", "band": "ReportHeader", "position": [72, 54], "size": [500, 16],
        "collection": "parameters", "field": "Display", "fontsize": 8, "color": "#555555"
      },
      "RunDate": {
        "type": "systemtext", "band": "ReportHeader", "position": [580, 54], "size": [140, 16],
        "systemvalue": "run_date", "prefix": "Prepared: ", "fontsize": 8,
        "align": "right", "color": "#555555"
      },
      "HeaderRule": {
        "type": "line", "band": "PageHeader", "position": [0, 4], "size": [720, 1],
        "bordercolor": "#6D7780", "borderwidth": 0.7
      },
      "Records": {
        "type": "table", "band": "Detail", "position": [0, 0], "size": [720, 188],
        "repeatcollection": "records",
        "columns": [
          {"name": "LastName", "label": "Last Name", "collection": "records", "field": "LastName", "width": 116.0},
          {"name": "FirstName", "label": "First Name", "collection": "records", "field": "FirstName", "width": 104.0},
          {"name": "Roles", "label": "Role(s)", "collection": "records", "field": "Roles", "width": 108.0},
          {"name": "Present", "label": "Present", "collection": "records", "field": "Present", "width": 60.0},
          {"name": "Absent", "label": "Absent", "collection": "records", "field": "Absent", "width": 58.0},
          {"name": "Excused", "label": "Excused", "collection": "records", "field": "Excused", "width": 64.0},
          {"name": "Notes", "label": "Notes", "collection": "records", "field": "Notes", "width": 210.0}
        ]
      },
      "FooterLine": {
        "type": "line", "band": "PageFooter", "position": [0, 0], "size": [720, 1],
        "bordercolor": "#808080", "borderwidth": 0.5
      },
      "FooterCode": {
        "type": "systemtext", "band": "PageFooter", "position": [0, 6], "size": [360, 14],
        "systemvalue": "report_code", "prefix": "ChurchManager report ", "fontsize": 8, "color": "#555555"
      },
      "PageNumber": {
        "type": "systemtext", "band": "PageFooter", "position": [630, 6], "size": [90, 14],
        "systemvalue": "page_number", "prefix": "Page ", "fontsize": 8, "align": "right", "color": "#555555"
      }
    }
  }
}
