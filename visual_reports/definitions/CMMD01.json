{
  "CMMD01REPORT": {
    "REPORT": {
      "schema_version": 1,
      "name": "CMMD01",
      "title": "Member Directory Master",
      "dataset": "membership.directory",
      "datasetversion": 1,
      "pagesize": "letter",
      "orientation": "portrait",
      "margins": {"top": 30, "right": 36, "bottom": 30, "left": 36},
      "theme": "churchmanager.standard",
      "bands": {
        "ReportHeader": {"type": "reportheader", "height": 112},
        "PageHeader": {"type": "pageheader", "height": 22, "repeat": true},
        "HouseholdHeader": {
          "type": "groupheader", "height": 96, "minimumheight": 42, "autofit": true
        },
        "PersonDetail": {"type": "detail", "height": 42},
        "HouseholdFooter": {"type": "groupfooter", "height": 9},
        "PageFooter": {"type": "pagefooter", "height": 24, "repeat": true}
      },
      "sort": [
        {"collection": "directory_people", "field": "FamilyName", "direction": "ascending"},
        {"collection": "directory_people", "field": "PersonName", "direction": "ascending"}
      ],
      "groups": [
        {
          "name": "Household", "collection": "directory_people", "field": "FamilyID",
          "headerband": "HouseholdHeader", "footerband": "HouseholdFooter", "keeptogether": true
        }
      ]
    },
    "CONTROLS": {
      "ChurchLogo": {
        "type": "image", "band": "ReportHeader", "position": [0, 0], "size": [76, 76],
        "collection": "church", "field": "Logo"
      },
      "ChurchName": {
        "type": "text", "band": "ReportHeader", "position": [88, 2], "size": [452, 24],
        "collection": "church", "field": "Church", "fontsize": 16, "bold": true, "align": "center"
      },
      "ReportTitle": {
        "type": "label", "band": "ReportHeader", "position": [88, 29], "size": [452, 21],
        "label": "Member Directory", "fontsize": 14, "bold": true, "align": "center"
      },
      "ChurchAddress": {
        "type": "text", "band": "ReportHeader", "position": [88, 54], "size": [250, 42],
        "collection": "church", "field": "AddressLines", "format": "address", "fontsize": 8
      },
      "ChurchPhone": {
        "type": "text", "band": "ReportHeader", "position": [350, 55], "size": [190, 16],
        "collection": "church", "field": "Phone", "format": "phone", "fontsize": 8, "align": "right"
      },
      "ChurchEmail": {
        "type": "text", "band": "ReportHeader", "position": [350, 76], "size": [190, 16],
        "collection": "church", "field": "eMail", "fontsize": 8, "align": "right"
      },
      "HeaderRule": {
        "type": "line", "band": "PageHeader", "position": [0, 18], "size": [540, 1],
        "bordercolor": "#6D7780", "borderwidth": 0.7
      },
      "HeaderLabel": {
        "type": "label", "band": "PageHeader", "position": [0, 1], "size": [540, 15],
        "label": "Household Directory", "fontsize": 9, "bold": true, "color": "#46525C"
      },
      "FamilyImage": {
        "type": "image", "band": "HouseholdHeader", "position": [0, 7], "size": [80, 72],
        "collection": "directory_people", "field": "FamilyImage", "affectautofit": false
      },
      "FamilyName": {
        "type": "text", "band": "HouseholdHeader", "position": [94, 4], "size": [250, 19],
        "collection": "directory_people", "field": "FamilyName", "fontsize": 11,
        "bold": true, "color": "#1F4058"
      },
      "MarriageStatus": {
        "type": "text", "band": "HouseholdHeader", "position": [350, 5], "size": [186, 16],
        "collection": "directory_people", "field": "MarriageStatus", "fontsize": 8,
        "italic": true, "align": "right", "color": "#555555"
      },
      "FamilyAddress": {
        "type": "text", "band": "HouseholdHeader", "position": [94, 30], "size": [250, 52],
        "collection": "directory_people", "field": "FamilyAddressLines", "format": "address", "fontsize": 8
      },
      "FamilyContacts": {
        "type": "text", "band": "HouseholdHeader", "position": [358, 30], "size": [178, 52],
        "collection": "directory_people", "field": "FamilyContactLines", "fontsize": 8
      },
      "Individuals": {
        "type": "repeater", "band": "PersonDetail", "position": [94, 0], "size": [442, 38],
        "repeatcollection": "directory_people", "itemheight": 42,
        "items": [
          {"name": "PersonName", "field": "PersonName", "position": [0, 1], "size": [250, 16], "fontsize": 9, "bold": true},
          {"name": "Relationship", "field": "Relationship", "position": [264, 1], "size": [174, 15], "fontsize": 8, "italic": true, "align": "right", "color": "#555555"},
          {"name": "PersonalDetails", "field": "PersonalDetails", "position": [20, 20], "size": [418, 14], "fontsize": 8, "color": "#333333"}
        ]
      },
      "HouseholdRule": {
        "type": "line", "band": "HouseholdFooter", "position": [0, 4], "size": [540, 1],
        "bordercolor": "#C5CBD0", "borderwidth": 0.5
      },
      "FooterLine": {
        "type": "line", "band": "PageFooter", "position": [0, 0], "size": [540, 1],
        "bordercolor": "#808080", "borderwidth": 0.5
      },
      "FooterText": {
        "type": "label", "band": "PageFooter", "position": [0, 6], "size": [540, 14],
        "label": "CMMD01 - ChurchManager Member Directory", "fontsize": 8,
        "color": "#555555", "align": "center"
      }
    }
  }
}
