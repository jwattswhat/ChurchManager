{
    "frmHymnSearchFORM": {
        "FORM": {
            "name": "frmHymnSearch",
            "type": "Panel",
            "title": "frmHymnSearch : Hymn Search Form",
            "controls": [
                "Close"
            ],
            "stylestr": "CAPTION",
            "nodataDB": true,
            "posch": [
                -1,
                -1
            ],
            "sizech": [
                80,
                60
            ]
        },
        "CONTROLS": {
            "lblSearch": {
                "type": "StaticText",
                "label": "Search:",
                "name": "lblSearch",
                "posch": [
                    1,
                    1
                ]
            },
            "Search": {
                "type": "TextCtrl",
                "name": "Search",
                "norecorddata": true,
                "posch": [
                    8,
                    1
                ],
                "sizech": [
                    24,
                    2
                ],
                "tooltip": "Enter the words or reference to search for."
            },
            "btnHymnSearchByHymn": {
                "type": "Button",
                "label": "By Hymn",
                "name": "btnHymnSearchByHymn",
                "posch": [
                    1,
                    3
                ],
                "sizech": [
                    8,
                    2
                ],
                "tooltip": "Search for hymns by hymn number."
            },
            "btnHymnSearchByTitle": {
                "type": "Button",
                "label": "By Title",
                "name": "btnHymnSearchByTitle",
                "posch": [
                    9,
                    3
                ],
                "sizech": [
                    8,
                    2
                ],
                "tooltip": "Search for hymns by title."
            },
            "btnHymnSearchByBible": {
                "type": "Button",
                "label": "By Bible",
                "name": "btnHymnSearchByBible",
                "posch": [
                    17,
                    3
                ],
                "sizech": [
                    8,
                    2
                ],
                "tooltip": "Search for hymns by Bible reference."
            },
            "btnHymnSearchByCategory": {
                "type": "Button",
                "label": "By Category",
                "name": "btnHymnSearchByCategory",
                "posch": [
                    25,
                    3
                ],
                "sizech": [
                    8,
                    2
                ],
                "tooltip": "Search for hymns by category."
            },
            "btnHymnSearchByNote": {
                "type": "Button",
                "label": "By Note",
                "name": "btnHymnSearchByNote",
                "posch": [
                    34,
                    3
                ],
                "sizech": [
                    8,
                    2
                ],
                "tooltip": "Search within hymn notes."
            },
            "dvlHymnList": {
                "name": "dvlHymnList",
                "type": "DataViewListCtrl",
                "table": {
                    "name": "tblHymn",
                    "fields": [
                        "ID",
                        "Hymn",
                        "Title",
                        "BibleText",
                        "Category",
                        "Note"
                    ],
                    "orderby": "Hymn"
                },
                "posch": [
                    1,
                    5
                ],
                "sizech": [
                    80,
                    48
                ],
                "column": [
                    {
                        "name": "ID",
                        "label": "ID",
                        "widthch": 0
                    },
                    {
                        "name": "Hymn",
                        "label": "Hymn",
                        "widthch": 10
                    },
                    {
                        "name": "Title",
                        "label": "Title",
                        "widthch": 20
                    },
                    {
                        "name": "BibleText",
                        "label": "BibleText",
                        "widthch": 10
                    },
                    {
                        "name": "Category",
                        "label": "Category",
                        "widthch": 10
                    },
                    {
                        "name": "Note",
                        "label": "Note",
                        "widthch": 30
                    }
                ],
                "tooltip": "View the hymn list records and select a row when needed."
            },
            "UsedAs": {
                "name": "UsedAs",
                "type": "ComboBox",
                "posch": [
                    1,
                    57
                ],
                "sizech": [
                    8,
                    2
                ],
                "tooltip": "Select the hymn usage."
            },
            "btnHymnSearchAdd": {
                "name": "btnHymnSearchAdd",
                "type": "Button",
                "label": "Add",
                "posch": [
                    9,
                    57
                ],
                "sizech": [
                    4,
                    2
                ],
                "tooltip": "Add the selected hymn to the service."
            }
        }
    }
}
