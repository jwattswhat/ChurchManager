{
    "frmScheduleFORM": {
        "FORM": {
            "name": "frmSchedule",
            "type": "Panel",
            "title": "frmSchedule: Schedule Edit Form",
            "table": {
                "name": "tblSchedule",
                "fields": [
                    "*"
                ],
                "Orderby": "Description, Time"
            },
            "stylelist": [
                "CAPTION"
            ],
            "controls": [
                "Navigation",
                "Close"
            ],
            "posch": [
                -1,
                -1
            ],
            "sizech": [
                60,
                34
            ],
            "layout": {"type": "responsive", "border": 3, "gap": 2},
            "theme": "churchmanager"
        },
        "CONTROLS": {
            "lblDescription": {
                "name": "lblDescriptionID",
                "type": "StaticText",
                "label": "Description:",
                "posch": [
                    1,
                    1
                ]
            },
            "Description": {
                "name": "Description",
                "type": "TextCtrl",
                "posch": [
                    10,
                    1
                ],
                "sizech": [
                    24,
                    2
                ],
                "tooltip": "Enter the description."
            },
            "lblTime": {
                "name": "lblTime",
                "type": "StaticText",
                "label": "Time:",
                "posch": [
                    1,
                    3
                ],
                "sizech": [
                    24,
                    2
                ]
            },
            "Time": {
                "name": "Time",
                "type": "TimePickerCtrl",
                "posch": [
                    10,
                    3
                ],
                "sizech": [
                    24,
                    2
                ],
                "tooltip": "Select the time."
            },
            "lblDaysofWeek": {
                "type": "StaticText",
                "label": "Days of Week:",
                "name": "lblDaysofWeek",
                "posch": [
                    1,
                    5
                ]
            },
            "DaysofWeek": {
                "type": "ListCtrl",
                "label": "Days of Week",
                "name": "DaysofWeek",
                "posch": [
                    10,
                    5
                ],
                "sizech": [
                    24,
                    12
                ],
                "tooltip": "Select one or more days of the week."
            },
            "lblMonths": {
                "type": "StaticText",
                "label": "Months:",
                "name": "lblMonths",
                "posch": [
                    35,
                    5
                ]
            },
            "Months": {
                "type": "ListCtrl",
                "label": "Months",
                "name": "Months",
                "posch": [
                    40,
                    5
                ],
                "sizech": [
                    24,
                    12
                ],
                "tooltip": "Select one or more months."
            },
            "lblSeasons": {
                "name": "lblSeaons",
                "type": "StaticText",
                "label": "Seasons",
                "posch": [
                    1,
                    17
                ]
            },
            "Seasons": {
                "name": "Seasons",
                "type": "ListCtrl",
                "label": "Seasons",
                "posch": [
                    10,
                    17
                ],
                "sizech": [
                    24,
                    12
                ],
                "tooltip": "Select one or more seasons."
            },
            "lblIncrement": {
                "name": "lblIncrement",
                "type": "StaticText",
                "label": "Increment:",
                "posch": [
                    1,
                    18
                ]
            },
            "Increment": {
                "name": "Increment",
                "type": "TextNumber",
                "format": "{:n}",
                "posch": [
                    10,
                    18
                ],
                "sizech": [
                    24,
                    2
                ],
                "tooltip": "Enter the increment."
            },
            "lblNote": {
                "type": "StaticText",
                "label": "Note",
                "name": "lblNote",
                "posch": [
                    1,
                    20
                ]
            },
            "Note": {
                "name": "Note",
                "type": "MultiLine",
                "stylelist": [
                    "MULTILINE",
                    "WORDWRAP"
                ],
                "posch": [
                    10,
                    20
                ],
                "sizech": [
                    24,
                    10
                ],
                "tooltip": "Enter the note. Multiple lines are allowed."
            }
        }
    }
}
