{
    "frmDocumentFORM": {
        "FORM": {
            "type": "Panel",
            "title": "frmDocument: Document Edit Form",
            "name": "frmDocument",
            "table": {
                "name": "tblDocument",
                "fields": [
                    "*"
                ],
                "orderby": "Date,Title DESC"
            },
            "stylelist": [
                "CAPTION"
            ],
            "posch": [
                -1,
                -1
            ],
            "sizech": [
                47,
                30
            ]
        },
        "CONTROLS": {
            "lblChurchID": {
                "type": "StaticText",
                "label": "Church:",
                "name": "lblChurchID",
                "posch": [
                    1,
                    1
                ]
            },
            "ChurchID": {
                "type": "ComboBox",
                "lookupchoices": {
                    "name": "tblChurch",
                    "fields": [
                        "ID",
                        "Church"
                    ],
                    "orderby": "Church"
                },
                "name": "ChurchID",
                "posch": [
                    9,
                    1
                ],
                "sizech": [
                    24,
                    2
                ],
                "defaultvalue": "Life in Christ Lutheran Church"
            },
            "lblTitle": {
                "type": "StaticText",
                "label": "Title:",
                "name": "lblTitle",
                "posch": [
                    1,
                    3
                ]
            },
            "Title": {
                "type": "TextCtrl",
                "name": "Title",
                "posch": [
                    9,
                    3
                ],
                "sizech": [
                    24,
                    2
                ]
            },
            "lblDocument": {
                "type": "StaticText",
                "label": "Document:",
                "name": "lblDocument",
                "posch": [
                    1,
                    5
                ]
            },
            "Document": {
                "name": "Document",
                "type": "FilePickerCtrl",
                "directory": [
                    "Location",
                    "Document"
                ],
                "stylelist": [
                    "FLPCHANGEDIR",
                    "FLPUSETEXTCTRL"
                ],
                "posch": [
                    9,
                    5
                ],
                "sizech": [
                    31,
                    2
                ]
            },
            "btnOpenDocument": {
                "name": "btnOpenDocument",
                "type": "Button",
