                "posch": [
                    9,
                    7
                ],
                "sizech": [
                    24,
                    2
                ]
            },
            "lblDate": {
                "type": "StaticText",
                "label": "Date:",
                "name": "lblDate",
                "posch": [
                    1,
                    9
                ]
            },
            "Date": {
                "type": "DatePickerCtrl",
                "name": "Date",
                "posch": [
                    9,
