{
    "frmPersonFORM": {
        "FORM": {
            "type": "Panel",
            "title": "frmPerson : Person Edit Form",
            "pos": [
                10,
                10
            ],
            "size": [
                725,
                500
            ],
            "name": "frmPerson",
            "table": {
                "name": "tblPerson",
                "fields": [
                    "ID",
                    "ChurchID",
                    "FamilyID",
                    "FirstName",
                    "MiddleName",
                    "LastName",
                    "Status",
                    "Baptized",
                    "Confirmed",
                    "Member",
                    "AssociateMember",
                    "Note"
                ],
                "orderby": "LastName,FirstName"
            },
            "stylelist": [
                "CAPTION"
            ],
            "linkedform": {
                "frmPersonAddress": {
                    "controls": [
                        "Close",
                        "Navigation"
                    ],
                    "table": {
                        "name": "tblPersonAddress",
                        "fields": [
                            "*"
                        ],
                        "condition": "PersonID = {ID}",
                        "orderby": "Address,Zip"
                    },
                    "readonlyfields": [
                        "PersonID"
                    ]
                },
                "frmPersonContact": {
                    "controls": [
                        "Close",
                        "Navigation"
                    ],
                    "table": {
                        "name": "tblPersonContact",
                        "fields": [
                            "*"
                        ],
                        "condition": "PersonID = {ID}",
                        "orderby": "Type"
                    },
                    "readonlyfields": [
                        "PersonID"
                    ]
                },
                "frmPersonDate": {
                    "controls": [
                        "Close",
                        "Navigation"
                    ],
                    "table": {
                        "name": "tblPersonDate",
                        "fields": [
                            "*"
                        ],
                        "condition": "PersonID = {ID}",
                        "orderby": "Date"
                    },
                    "readonlyfields": [
                        "PersonID"
                    ]
                }
            }
        },
        "CONTROLS": {
            "btnPersonAddress": {
                "type": "Button",
                "label": "Add/Edit/Delete Person Addresses",
                "pos": [
                    450,
                    30
                ],
                "name": "btnPersonAddress",
                "action":["openform","frmPersonAddress"]
            },
            "btnPersonContact": {
                "type": "Button",
                "label": "Add/Edit/Delete Person Contacts",
                "pos": [
                    450,
                    60
                ],
                "name": "btnPersonContact",
                "action": ["openform","frmPersonContact"]
            },
            "btnPersonDate": {
                "type": "Button",
                "label": "Add/Edit/Delete Person Date",
