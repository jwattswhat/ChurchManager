                "pos": [
                    0,
                    60
                ],
                "name": "lblReading"
            },
            "Reading": {
                "type": "ComboBox",
                "pos": [
                    125,
                    60
                ],
                "size": [
                    300,
                    30
                ],
                "name": "Reading"
            },
            "lblReference": {
                "type": "StaticText",
                "label": "Reference:",
                "pos": [
                    0,
                    90
                ],
                "name": "lblReference"
            },
            "Reference": {
                "type": "TextCtrl",
                "pos": [
                    125,
                    90
                ],
                "size": [
                    300,
                    30
                ],
                "name": "Reference"
            },
            "lblNote": {
                "type": "StaticText",
                "label": "Note",
                "pos": [
                    0,
                    120
                ],
                "name": "lblNote"
            },
            "Note": {
                "type": "MultiLine",
                "pos": [
                    125,
                    120
                ],
                "size": [
                    300,
                    100
                ],
                "stylelist": [
                    "MULTILINE"
                ],
                "name": "Note"
            }
        }
