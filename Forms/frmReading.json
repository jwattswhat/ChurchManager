{
    "frmReadingFORM": {
        "FORM": {
            "type": "Panel",
            "title": "frmReading: Reading Edit Form",
            "pos": [
                10,
                10
            ],
            "size": [
                620,
                450
            ],
            "name": "frmReading",
            "table": {
                "name": "tblReading",
                "fields": [
                    "ID",
                    "PropersID",
                    "Reading",
                    "Reference",
                    "Note"
                ],
                "orderby": "PropersID"
            },
            "stylelist": [
                "CAPTION"
            ]
        },
        "CONTROLS": {
            "lblPropers": {
                "name": "lblPropers",
                "type": "StaticText",
                "label": "Proper:",
                "pos": [
                    0,
                    30
                ]
            },
            "PropersID": {
                "name": "PropersID",
                "type": "ComboBox",
                "lookupchoices": {
                    "name": "tblPropers",
                    "fields": [
                        "ID",
                        "CONCAT(Lectionary,' ',LiturgicalDate)"
                    ],
                    "orderby": "Lectionary, Sort",
                    "condition": "ID={PropersID}"
                },
                "pos": [
                    125,
                    30
                ],
                "size": [
                    300,
                    30
                ],
                "readonly": true
            },
            "lblReading": {
                "type": "StaticText",
