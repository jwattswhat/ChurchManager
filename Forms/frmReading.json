{
    "frmReadingFORM": {
        "FORM": {
            "type": "Panel",
            "title": "frmReading: Reading Edit Form",
            "name": "frmReading",
            "table": {
                "name": "tblReading",
                "fields": [
                    "ID",
                    "PropersID",
                    "Reading",
                    "Reference",
                    "Note"
                ],
                "orderby": "PropersID"
            },
            "stylelist": [
                "CAPTION"
            ],
            "posch": [
                -1,
                -1
            ],
            "sizech": [
                51,
                37
            ],
            "theme": "churchmanager"
        },
        "CONTROLS": {
            "lblPropers": {
                "name": "lblPropers",
                "type": "StaticText",
                "label": "Proper:",
                "posch": [
                    1,
                    1
                ]
            },
            "PropersID": {
                "name": "PropersID",
                "type": "ComboBox",
                "lookupchoices": {
                    "name": "vwPropersLookup",
                    "fields": [
                        "ID",
                        "DisplayName"
                    ],
                    "orderby": "SystemName, Cycle, Sort",
                    "condition": "ID={PropersID}"
                },
                "readonly": true,
                "posch": [
                    10,
                    1
                ],
                "sizech": [
                    24,
                    2
                ],
                "tooltip": "Select the propers."
            },
            "lblReading": {
                "type": "StaticText",
                "label": "Reading:",
                "name": "lblReading",
                "posch": [
                    1,
                    3
                ]
            },
            "Reading": {
                "type": "ComboBox",
                "name": "Reading",
                "posch": [
                    10,
                    3
                ],
                "sizech": [
                    24,
                    2
                ],
                "tooltip": "Select the reading."
            },
            "lblReference": {
                "type": "StaticText",
                "label": "Reference:",
                "name": "lblReference",
                "posch": [
                    1,
                    5
                ]
            },
            "Reference": {
                "type": "TextCtrl",
                "name": "Reference",
                "posch": [
                    10,
                    5
                ],
                "sizech": [
                    24,
                    2
                ],
                "tooltip": "Enter the reference."
            },
            "lblNote": {
                "type": "StaticText",
                "label": "Note:",
                "name": "lblNote",
                "posch": [
                    1,
                    7
                ]
            },
            "Note": {
                "type": "MultiLine",
                "stylelist": [
                    "MULTILINE"
                ],
                "name": "Note",
                "posch": [
                    10,
                    7
                ],
                "sizech": [
                    24,
                    8
                ],
                "tooltip": "Enter the note. Multiple lines are allowed."
            }
        }
    }
}
