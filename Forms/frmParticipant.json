{
    "frmParticipantFORM": {
        "FORM": {
            "name": "frmParticipant",
            "type": "Panel",
            "title": "frmParticipant: Participant Edit Form",
            "table": {
                "name": "tblParticipant",
                "fields": [
                    "ID",
                    "Name",
                    "Roles",
                    "Schedule",
                    "Note"
                ],
                "orderby": "Name"
            },
            "controls": [
                "Navigation",
                "Close"
            ],
            "stylelist": [
                "CAPTION"
            ],
            "posch": [
                0,
                0
            ],
            "sizech": [
                62,
                45
            ],
            "theme": "churchmanager"
        },
        "CONTROLS": {
            "lblName": {
                "type": "StaticText",
                "label": "Name:",
                "name": "lblName",
                "posch": [
                    0,
                    2
                ]
            },
            "Name": {
                "name": "Name",
                "type": "TextCtrl",
                "posch": [
                    10,
                    2
                ],
                "sizech": [
                    24,
                    2
                ],
                "tooltip": "Enter the name."
            },
            "lblRoles": {
                "type": "StaticText",
                "label": "Roles:",
                "name": "lblRole",
                "posch": [
                    0,
                    4
                ]
            },
            "Roles": {
                "name": "Roles",
                "type": "ListCtrl",
                "label": "Roles",
                "posch": [
                    0,
                    7
                ],
                "sizech": [
                    29,
                    16
                ],
                "tooltip": "Select one or more roles."
            },
            "lblSchedule": {
                "type": "StaticText",
                "label": "Schedule:",
                "name": "lblSchedules",
                "posch": [
                    31,
                    4
                ]
            },
            "Schedule": {
                "name": "Schedule",
                "type": "ListCtrlID",
                "label": "Schedule",
                "lookupchoices": {
                    "name": "tblSchedule",
                    "fields": [
                        "ID",
                        "Description"
                    ],
                    "orderby": "Description"
                },
                "lookup": {
                    "table": "tblSchedule",
                    "fields": [
                        "ID",
                        "Description"
                    ],
                    "display": "Description",
                    "key": "ID",
                    "orderby": "Description"
                },
                "posch": [
                    31,
                    7
                ],
                "sizech": [
                    24,
                    16
                ],
                "tooltip": "Select one or more schedule."
            },
            "lblNote": {
                "type": "StaticText",
                "label": "Note",
                "name": "lblNote",
                "posch": [
                    0,
                    24
                ]
            },
            "Note": {
                "name": "Note",
                "type": "MultiLine",
                "stylelist": [
                    "MULTILINE",
                    "WORDWRAP"
                ],
                "posch": [
                    10,
                    24
                ],
                "sizech": [
                    24,
                    8
                ],
                "tooltip": "Enter the note. Multiple lines are allowed."
            }
        }
    }
}
