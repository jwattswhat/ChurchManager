{
    "frmPropersFORM": {
        "FORM": {
            "type": "Panel",
            "title": "frmPropers: Propers Edit Form",
            "name": "frmPropers",
            "table": {
                "name": "tblPropers",
                "fields": [
                    "*"
                ],
                "orderby": "LectionarySystemID, Cycle, Sort"
            },
            "linkedform": {
                "frmLectionarySystem": {
                    "name": "frmLectionarySystem",
                    "type": "Panel",
                    "title": "Lectionary Systems",
                    "table": {
                        "name": "tblLectionarySystem",
                        "fields": [
                            "*"
                        ],
                        "condition": "ID = {LectionarySystemID}"
                    },
                    "controls": [
                        "Update",
                        "Close"
                    ]
                }
            },
            "stylelist": [
                "CAPTION"
            ],
            "posch": [
                -1,
                -1
            ],
            "sizech": [
                64,
                35
            ],
            "layout": {"type": "legacy"},
            "theme": "churchmanager"
        },
        "CONTROLS": {
            "lblLectionarySystemID": {
                "type": "StaticText",
                "label": "System:",
                "name": "lblLectionarySystemID",
                "posch": [
                    1,
                    1
                ]
            },
            "LectionarySystemID": {
                "type": "ComboBox",
                "name": "LectionarySystemID",
                "lookupchoices": {
                    "name": "tblLectionarySystem",
                    "fields": [
                        "ID",
                        "Name"
                    ],
                    "condition": "Active = 1",
                    "orderby": "Name"
                },
                "posch": [
                    10,
                    1
                ],
                "sizech": [
                    20,
                    2
                ],
                "tooltip": "Select the lectionary."
            },
            "btnLectionarySystem": {
                "name": "btnLectionarySystem",
                "type": "Button",
                "label": "Systems",
                "action": [
                    "openlinkedform",
                    "frmLectionarySystem"
                ],
                "posch": [
                    25,
                    3
                ],
                "tooltip": "Edit the selected lectionary system."
            },
            "lblCycle": {
                "name": "lblCycle",
                "type": "StaticText",
                "label": "Cycle:",
                "posch": [
                    1,
                    3
                ]
            },
            "Cycle": {
                "name": "Cycle",
                "type": "ComboBox",
                "choices": [
                    "A",
                    "B",
                    "C"
                ],
                "posch": [
                    10,
                    3
                ],
                "sizech": [
                    10,
                    2
                ],
                "tooltip": "Enter A, B, C, another cycle label, or leave blank."
            },
            "lblTheme": {
                "type": "StaticText",
                "label": "Theme:",
                "name": "lblTheme",
                "posch": [
                    34,
                    1
                ]
            },
            "Theme": {
                "type": "MultiLine",
                "stylelist": [
                    "MULTILINE",
                    "WORDWRAP"
                ],
                "name": "Theme",
                "posch": [
                    39,
                    1
                ],
                "sizech": [
                    23,
                    6
                ],
                "tooltip": "Enter the theme. Multiple lines are allowed."
            },
            "lblSort": {
                "type": "StaticText",
                "label": "Sort:",
                "name": "lblSort",
                "posch": [
                    1,
                    5
                ]
            },
            "Sort": {
                "type": "TextCtrl",
                "name": "Sort",
                "posch": [
                    10,
                    5
                ],
                "sizech": [
                    24,
                    2
                ],
                "tooltip": "Enter the sort."
            },
            "lblSeason": {
                "type": "StaticText",
                "label": "Season:",
                "name": "lblSeason",
                "posch": [
                    1,
                    7
                ]
            },
            "Season": {
                "type": "ComboBox",
                "name": "Season",
                "posch": [
                    10,
                    7
                ],
                "sizech": [
                    24,
                    2
                ],
                "tooltip": "Select the season."
            },
            "lblLiturgicalDate": {
                "type": "StaticText",
                "label": "Liturgical Date:",
                "name": "lblLiturgicalDate",
                "posch": [
                    1,
                    9
                ]
            },
            "LiturgicalDate": {
                "type": "TextCtrl",
                "name": "LiturgicalDate",
                "posch": [
                    10,
                    9
                ],
                "sizech": [
                    24,
                    2
                ],
                "tooltip": "Enter the liturgical date."
            },
            "lblHymnSug": {
                "type": "StaticText",
                "label": "Hymns:",
                "name": "lblHymnSug",
                "posch": [
                    34,
                    8
                ]
            },
            "HymnSug": {
                "type": "MultiLine",
                "stylelist": [
                    "MULTILINE",
                    "WORDWRAP"
                ],
                "name": "HymnSug",
                "posch": [
                    39,
                    8
                ],
                "sizech": [
                    23,
                    6
                ],
                "tooltip": "Enter the hymn sug. Multiple lines are allowed."
            },
            "lblColor": {
                "type": "StaticText",
                "label": "Liturgical Color:",
                "name": "lblColor",
                "posch": [
                    1,
                    11
                ]
            },
            "Color": {
                "type": "ComboBox",
                "name": "Color",
                "posch": [
                    10,
                    11
                ],
                "sizech": [
                    24,
                    2
                ],
                "tooltip": "Select the color."
            },
            "lblAltColor": {
                "type": "StaticText",
                "label": "Alt Color:",
                "name": "lblAltColor",
                "posch": [
                    1,
                    13
                ]
            },
            "AltColor": {
                "type": "ComboBox",
                "name": "AltColor",
                "posch": [
                    10,
                    13
                ],
                "sizech": [
                    24,
                    2
                ],
                "tooltip": "Select the alt color."
            },
            "dvlReadings": {
                "name": "dvlReadings",
                "type": "DataViewListCtrl",
                "table": {
                    "name": "tblReading",
                    "fields": [
                        "ID",
                        "Reading",
                        "Reference",
                        "Note"
                    ],
                    "condition": "PropersID = {ID}"
                },
                "column": [
                    {
                        "name": "Reading",
                        "label": "Reading",
                        "widthch": 8
                    },
                    {
                        "name": "Reference",
                        "label": "Reference",
                        "widthch": 10
                    },
                    {
                        "name": "Note",
                        "label": "Note",
                        "widthch": 20
                    }
                ],
                "posch": [
                    1,
                    15
                ],
                "sizech": [
                    33,
                    8
                ],
                "tooltip": "View the readings records and select a row when needed."
            },
            "lblNote": {
                "type": "StaticText",
                "label": "Note:",
                "name": "lblNote",
                "posch": [
                    1,
                    24
                ]
            },
            "Note": {
                "name": "Note",
                "type": "MultiLine",
                "stylelist": [
                    "MULTILINE"
                ],
                "posch": [
                    10,
                    24
                ],
                "sizech": [
                    24,
                    8
                ],
                "tooltip": "Enter the note. Multiple lines are allowed."
            },
            "lblIntroit": {
                "type": "StaticText",
                "label": "Introit:",
                "name": "lblIntroit",
                "posch": [
                    34,
                    15
                ]
            },
            "Introit": {
                "type": "MultiLine",
                "stylelist": [
                    "MULTILINE"
                ],
                "name": "Introit",
                "posch": [
                    39,
                    15
                ],
                "sizech": [
                    23,
                    17
                ],
                "tooltip": "Enter the introit. Multiple lines are allowed."
            }
        }
    }
}
