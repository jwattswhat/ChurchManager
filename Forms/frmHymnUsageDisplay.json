{
    "frmHymnUsageDisplayFORM": {
        "FORM": {
            "type": "Panel",
            "name": "frmHymnUsageDisplay",
            "title": "frmHymnUsageDisplay : HymnUsageDisplay",
            "table": {
                "name": "tblService",
                "fields": [
                    "ID",
                    "DateTime"
                ],
                "orderby": "DateTime DESC"
            },
            "stylelist": ["CAPTION"],
            "linkedform": {
                "frmHymnSearch": {
                    "table": {
                        "name": "tblHymn",
                        "fields": [
                            "*"
                        ]
                    },
                    "bindbtn": "btnHymnUsageAdd",
                    "controls": [
                        "Close"
                    ],
                    "stylelist": [
                        "CAPTION"
                    ],
                    "posch": [
                        8,
                        8
                    ]
                },
                "frmNote": {
                    "name": "frmNote",
                    "nodataDB": true,
                    "table": {
                        "name": "tblHymnUsage",
                        "fields": [
                            "Note"
                        ]
                    },
                    "bindbtn": "btnChangeNote",
                    "controls": [],
                    "stylelist": [
                        "CAPTION"
                    ],
                    "posch": [
                        8,
                        8
                    ]
                }
            },
            "posch": [
                0,
                0
            ],
            "sizech": [
                66,
                33
            ]
        },
        "CONTROLS": {
            "lblService": {
                "name": "lblService",
                "type": "StaticText",
                "label": "Service:",
                "readonly": true,
                "posch": [
                    2,
                    2
                ]
            },
            "DateTime": {
                "name": "DateTime",
                "type": "DateTime",
                "readonly": true,
                "posch": [
                    12,
                    2
                ],
                "sizech": [
                    24,
                    2
                ]
            },
            "boxHymns": {
                "name": "boxHymns",
                "type": "StaticBox",
                "label": "Hymns",
                "posch": [
                    0,
                    4
                ],
                "sizech": [
                    64,
                    20
                ]
            },
            "dvlHymnUsage": {
                "name": "dvlHymnUsage",
                "type": "DataViewListCtrl",
                "table": {
                    "name": "tblHymnUsage",
                    "fields": [
                        "ID",
                        "ServiceID",
                        "HymnID",
                        "HymnID as Title",
                        "UsedAs",
                        "Note"
                    ],
                    "condition": "ServiceID = {ID}"
                },
                "column": [
                    {
                        "name": "UsedAs",
                        "label": "UsedAs",
                        "width": 100
                    },
                    {
                        "name": "HymnID",
                        "label": "Hymn",
                        "width": 200,
                        "lookupchoices": {
                            "name": "tblHymn",
                            "fields": [
                                "Hymn"
                            ],
                            "condition": "ID = {HymnID}"
                        }
                    },
                    {
                        "name": "Title",
                        "label": "Title",
                        "width": 400,
                        "lookupchoices": {
                            "name": "tblHymn",
                            "fields": [
                                "Title"
                            ],
                            "condition": "ID = {HymnID}"
                        }
                    }
                ],
                "posch": [
                    2,
                    7
                ],
                "sizech": [
                    58,
                    13
                ]
            },
            "btnHymnUsageAdd": {
                "name": "btnHymnUsageAdd",
                "type": "Button",
                "label": "Add",
                "posch": [
                    1,
                    21
                ]
            },
            "btnHymnDelete": {
                "name": "btnHymnDelete",
                "type": "Button",
                "label": "Delete",
                "posch": [
                    9,
                    21
                ]
            },
            "btnChangeNote": {
                "name": "btnChangeNote",
                "type": "Button",
                "label": "Change Note",
                "linkedfield": "dvlHymnUsage",
                "posch": [
                    16,
                    21
                ]
            }
        }
    }
}