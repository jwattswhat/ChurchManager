{
    "frmAltReadingFORM": {
        "FORM": {
            "name": "frmAltReading",
            "type": "Panel",
            "title": "frmAltReading: AltReading Edit Form",
            "table": {
                "name": "tblAltReading",
                "fields": [
                    "*"
                ],
                "Orderby": "ServiceID"
            },
            "stylelist": [
                "CAPTION"
            ],
            "posch": [
                20,
                -1
            ],
            "sizech": [
                35,
                20
            ],
            "theme": "churchmanager"
        },
        "CONTROLS": {
            "lblServiceID": {
                "type": "StaticText",
                "label": "Service:",
                "name": "lblServiceID",
                "posch": [
                    1,
                    1
                ]
            },
            "ServiceID": {
                "name": "ServiceID",
                "type": "ComboBox",
                "lookupchoices": {
                    "name": "tblService",
                    "fields": [
                        "ID",
                        "DateTime"
                    ],
                    "orderby": "DateTime"
                },
                "posch": [
                    10,
                    1
                ],
                "sizech": [
                    24,
                    2
                ],
                "tooltip": "Select the service."
            },
            "lblReading": {
                "type": "StaticText",
                "label": "Alt Reading:",
                "name": "lblReading",
                "posch": [
                    1,
                    3
                ]
            },
            "Reading": {
                "type": "ComboBox",
                "name": "Reading",
                "posch": [
                    10,
                    3
                ],
                "sizech": [
                    24,
                    4
                ],
                "tooltip": "Select the reading."
            },
            "lblReference": {
                "type": "StaticText",
                "label": "Reference:",
                "name": "lblReference",
                "posch": [
                    1,
                    5
                ]
            },
            "Reference": {
                "type": "TextCtrl",
                "name": "Reference",
                "posch": [
                    10,
                    5
                ],
                "sizech": [
                    24,
                    2
                ],
                "tooltip": "Enter the reference."
            },
            "lblNote": {
                "type": "StaticText",
                "label": "Note:",
                "name": "lblNote",
                "posch": [
                    1,
                    7
                ]
            },
            "Note": {
                "name": "Note",
                "type": "MultiLine",
                "stylelist": [
                    "MULTILINE",
                    "WORDWRAP"
                ],
                "posch": [
                    10,
                    7
                ],
                "sizech": [
                    24,
                    10
                ],
                "tooltip": "Enter the note. Multiple lines are allowed."
            }
        }
    }
}
