{
  "frmProperHymnSuggestionFORM": {
    "FORM": {
      "name": "frmProperHymnSuggestion",
      "type": "Panel",
      "title": "Suggested Hymn",
      "table": {
        "name": "tblProperHymnSuggestion",
        "fields": ["ID", "PropersID", "HymnID", "SuggestedAs", "Note"],
        "orderby": "ID"
      },
      "linkedform": {
        "frmHymn": {
          "name": "frmHymn",
          "type": "Panel",
          "title": "Hymn Catalog",
          "table": {"name": "tblHymn", "fields": ["*"], "orderby": "Hymn"},
          "controls": ["Navigation", "Update", "Delete", "Close"]
        }
      },
      "stylelist": ["CAPTION"],
      "posch": [-1, -1],
      "sizech": [55, 20],
      "theme": "churchmanager"
    },
    "CONTROLS": {
      "lblHymnID": {"name": "lblHymnID", "type": "StaticText", "label": "Hymn:", "posch": [1, 1]},
      "HymnID": {
        "name": "HymnID",
        "type": "ComboBox",
        "posch": [12, 1],
        "sizech": [30, 2],
        "lookupchoices": {"name": "tblHymn", "fields": ["ID", "Hymn", "Title"], "orderby": "Hymn, Title"},
        "tooltip": "Select a hymn suggested for this Proper. The list shows the hymn number and title."
      },
      "btnHymnCatalog": {
        "name": "btnHymnCatalog",
        "type": "Button",
        "label": "Hymn Catalog...",
        "action": ["openlinkedform", "frmHymn"],
        "posch": [44, 1],
        "tooltip": "Review, add, edit, or delete hymns in the hymn catalog."
      },
      "lblSuggestedAs": {"name": "lblSuggestedAs", "type": "StaticText", "label": "Suggested for:", "posch": [1, 3]},
      "SuggestedAs": {
        "name": "SuggestedAs",
        "type": "ComboBox",
        "posch": [12, 3],
        "sizech": [20, 2],
        "choices": ["", "Hymn of Invocation", "Hymn of the Day", "Communion", "Closing"],
        "tooltip": "Optionally identify the service position."
      },
      "lblNote": {"name": "lblNote", "type": "StaticText", "label": "Note:", "posch": [1, 5]},
      "Note": {
        "name": "Note",
        "type": "MultiLine",
        "stylelist": ["MULTILINE", "WORDWRAP"],
        "posch": [12, 5],
        "sizech": [30, 8],
        "tooltip": "Enter an optional planning note."
      }
    }
  }
}
