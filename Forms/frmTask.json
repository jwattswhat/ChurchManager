{
    "frmTaskFORM": {
        "FORM": {
            "type": "Panel",
            "title": "frmTask: Task Edit Form",
            "name": "frmTask",
            "table": {
                "name": "tblTask",
                "fields": [
                    "*"
                ],
                "orderby": "Complete,StartDate"
            },
            "stylelist": [
                "CAPTION"
            ],
            "controls": [
                "Navigation",
                "Close"
            ],
            "linkedform": {
                "frmTaskWorker": {
                    "name": "frmTaskWorker",
                    "type": "Panel",
                    "controls": [
                        "Navigation",
                        "Update",
                        "Close"
                    ],
                    "table": {
                        "name": "tblTaskWorker",
                        "fields": [
                            "*"
                        ],
                        "condition": "TaskID = {ID}",
                        "orderby": "Task"
                    },
                    "readonlyfields": [
                        "TaskID"
                    ],
                    "fillonblank": [
                        "TaskID",
                        "ID"
                    ],
                    "bindbtn": "btnTaskWorker"
                }
            },
            "posch": [
                -1,
                -1
            ],
            "sizech": [
                45,
                30
            ],
            "theme": "churchmanager"
        },
        "CONTROLS": {
            "lblTask": {
                "type": "StaticText",
                "label": "Task:",
                "name": "lblTask",
                "posch": [
                    1,
                    1
                ]
            },
            "Task": {
                "type": "TextCtrl",
                "name": "Task",
                "posch": [
                    9,
                    1
                ],
                "sizech": [
                    24,
                    2
                ],
                "tooltip": "Enter the task."
            },
            "btnTaskWorker": {
                "type": "Button",
                "label": "Workers",
                "action": [
                    "openlinkedform",
                    "frmTaskWorker"
                ],
                "name": "btnTaskWorker",
                "posch": [
                    37,
                    1
                ],
                "tooltip": "Open the workers form."
            },
            "lblDescription": {
                "type": "StaticText",
                "label": "Description:",
                "name": "lblDescription",
                "posch": [
                    1,
                    3
                ]
            },
            "Description": {
                "type": "TextCtrl",
                "name": "Description",
                "posch": [
                    9,
                    3
                ],
                "sizech": [
                    24,
                    2
                ],
                "tooltip": "Enter the description."
            },
            "lblPriority": {
                "type": "StaticText",
                "label": "Priority:",
                "name": "lblPriority",
                "posch": [
                    1,
                    5
                ]
            },
            "Priority": {
                "type": "ComboBox",
                "name": "Priority",
                "posch": [
                    9,
                    5
                ],
                "sizech": [
                    24,
                    2
                ],
                "tooltip": "Select the priority."
            },
            "lblComplete": {
                "type": "StaticText",
                "label": "Complete:",
                "name": "lblComplete",
                "posch": [
                    1,
                    7
                ]
            },
            "Complete": {
                "type": "CheckBox",
                "name": "Complete",
                "posch": [
                    9,
                    7
                ],
                "sizech": [
                    24,
                    2
                ],
                "tooltip": "Select this if complete applies."
            },
            "lblCompletionDate": {
                "type": "StaticText",
                "label": "Completion Date:",
                "name": "lblCompletionDate",
                "posch": [
                    1,
                    9
                ]
            },
            "CompletionDate": {
                "type": "DatePickerCtrl",
                "name": "CompletionDate",
                "stylelist": [
                    "ALLOWNONE"
                ],
                "defaultvalue": null,
                "posch": [
                    9,
                    9
                ],
                "sizech": [
                    20,
                    2
                ],
                "tooltip": "Select the completion date."
            },
            "lblProjectID": {
                "type": "StaticText",
                "label": "Project:",
                "name": "lblProjectID",
                "posch": [
                    1,
                    11
                ]
            },
            "ProjectID": {
                "type": "ComboBox",
                "lookupchoices": {
                    "name": "tblProject",
                    "fields": [
                        "ID",
                        "Project"
                    ],
                    "orderby": "StartDate,Project"
                },
                "name": "ProjectID",
                "posch": [
                    9,
                    11
                ],
                "sizech": [
                    24,
                    2
                ],
                "tooltip": "Select the project."
            },
            "lblDependencyID": {
                "type": "StaticText",
                "label": "Dependencies:",
                "name": "lblDependencyID",
                "posch": [
                    1,
                    13
                ]
            },
            "DependencyID": {
                "type": "TextCtrl",
                "name": "DependencyID",
                "posch": [
                    9,
                    13
                ],
                "sizech": [
                    24,
                    2
                ],
                "tooltip": "Enter the task dependency."
            },
            "lblStartDate": {
                "name": "lblStartDate",
                "type": "StaticText",
                "label": "Start Date:",
                "posch": [
                    1,
                    15
                ]
            },
            "StartDate": {
                "name": "StartDate",
                "type": "DatePickerCtrl",
                "stylelist": [
                    "ALLOWNONE"
                ],
                "defaultvalue": null,
                "posch": [
                    9,
                    15
                ],
                "sizech": [
                    20,
                    2
                ],
                "tooltip": "Select the start date."
            },
            "lblEndDate": {
                "name": "lblEndDate",
                "type": "StaticText",
                "label": "End Date:",
                "posch": [
                    1,
                    17
                ]
            },
            "EndDate": {
                "name": "EndDate",
                "type": "DatePickerCtrl",
                "stylelist": [
                    "ALLOWNONE"
                ],
                "defaultvalue": null,
                "posch": [
                    9,
                    17
                ],
                "sizech": [
                    20,
                    2
                ],
                "tooltip": "Select the end date."
            },
            "lblNote": {
                "type": "StaticText",
                "label": "Note:",
                "name": "lblNote",
                "posch": [
                    1,
                    19
                ]
            },
            "Note": {
                "type": "MultiLine",
                "stylelist": [
                    "MULTILINE"
                ],
                "name": "Note",
                "posch": [
                    9,
                    19
                ],
                "sizech": [
                    24,
                    8
                ],
                "tooltip": "Enter the note. Multiple lines are allowed."
            }
        }
    }
}
