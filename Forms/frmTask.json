{
    "frmTaskFORM": {
        "FORM": {
            "type": "Panel",
            "title": "frmTask: Task Edit Form",
            "pos": [
                10,
                10
            ],
            "size": [
                550,
                450
            ],
            "name": "frmTask",
            "table": {
                "name": "tblTask",
                "fields": [
                    "*"
                ],
                "orderby": "Complete,StartDate"
            },
            "stylelist": [
                "CAPTION"
            ], "controls" : ["Navigation","Close"],
            "linkedform": {
                "frmTaskWorker" : {
                    "name": "frmTaskWorker",
                    "type": "Panel",
                    "pos": [100,100],
                    "controls": [
                        "Navigation",
                        "Update",
                        "Close"
                    ],
                    "table": {
                        "name" : "tblTaskWorker",
                        "fields" : ["*"],
                        "condition": "TaskID = {ID}",
                        "orderby": "Task"
                    },
                    "readonlyfields": [
                        "TaskID"
                    ],
                    "fillonblank": [
                        "TaskID",
                        "ID"
                    ],
                    "bindbtn": "btnTaskWorker"
                }
            }
        },
        "CONTROLS": {
            "lblTask": {
                "type": "StaticText",
                "label": "Task:",
                "pos": [
                    0,
                    30
                ],
                "name": "lblTask"
            },
            "Task": {
                "type": "TextCtrl",
                "pos": [
                    120,
                    30
                ],
                "size": [
                    300,
                    30
                ],
                "name": "Task"
            },
            "btnTaskWorker": {
                "type": "Button",
                "label": "Workers",
                "pos": [450,30],
                "action": ["openlinkedform","frmTaskWorker"],
                "name": "btnTaskWorker"
            },
            "lblDescription": {
                "type": "StaticText",
                "label": "Description:",
                "pos": [
                    0,
                    60
                ],
                "name": "lblDescription"
            },
            "Description": {
                "type": "TextCtrl",
                "pos": [
                    120,
                    60
                ],
                "size": [
                    300,
                    30
                ],
                "name": "Description"
            },
            "lblPriority": {
                "type": "StaticText",
                "pos": [0,90],
                "label": "Priority:",
                "name": "lblPriority"
            },
            "Priority" : {
                "type": "ComboBox",
                "pos": [120,90],
                "size": [300,30],
                "name" : "Priority"
            },

            "lblComplete": {
                "type": "StaticText",
                "label": "Complete:",
                "pos": [
                    0,
                    120
                ],
                "name": "lblComplete"
            },
            "Complete": {
                "type": "CheckBox",
                "pos": [
                    120,
                    120
                ],
                "size": [
                    300,
                    30
                ],
                "name": "Complete"
            },
            "lblCompletionDate": {
                "type": "StaticText",
                "label": "Completion Date:",
                "pos": [
                    0,
                    150
                ],
                "name": "lblCompletionDate"
            },
            "CompletionDate": {
                "type": "DatePickerCtrl",
                "pos": [
                    120,
                    150
                ],
                "size": [
                    300,
                    30
                ],
                "name": "CompletionDate",
                "stylelist": ["ALLOWNONE"]

            },
            "lblProjectID": {
                "type": "StaticText",
                "label": "Project:",
                "pos": [
                    0,
                    180
                ],
                "name": "Project"
            },
            "ProjectID": {
                "type": "ComboBox",
                "pos": [
                    120,
                    180
                ],
                "size": [
                    300,
                    30
                ],
                "lookupchoices" : {
                    "name": "tblProject",
                    "fields" : ["ID","Project"],
                    "orderby" : "StartDate,Project"
                },
                "name": "ProjectID"
            },
            "lblDependencyID": {
                "type": "StaticText",
                "label": "Dependencies:",
                "pos": [
                    0,
                    210
                ],
                "name": "lblDependencyID"
            },
            "DependencyID": {
                "type": "TextCtrl",
                "pos": [
                    120,
                    210
                ],
                "size": [300,30],
                "name": "DependencyID"
            },
            "lblStartDate": {
                "name" : "lblStartDate"
                ,"type" : "StaticText",
                "pos" : [0,240],
                "label": "Start Date:"
            },
            "StartDate" : {
                "name" : "StartDate",
                "type": "DatePickerCtrl",
                "pos" : [120,240],
                "size" : [300,30],
                "stylelist": ["ALLOWNONE"]
            },
            "lblEndDate": {
                "name" : "lblEndDate"
                ,"type" : "StaticText",
                "pos" : [0,270],
                "label": "End Date:"
            },
            "EndDate" : {
                "name" : "EndDate",
                "type": "DatePickerCtrl",
                "pos" : [120,270],
                "size" : [300,30],
                "stylelist": ["ALLOWNONE"]
            },
            "lblNote": {
                "type": "StaticText",
                "label": "Note:",
                "pos": [
                    0,
                    300
                ],
                "name": "lblNote"
            },
            "Note": {
                "type": "MultiLine",
                "pos": [
                    120,
                    300
                ],
                "size": [
                    300,
                    100
                ],
                "stylelist": [
                    "MULTILINE"
                ],
                "name": "Note"
            }
        }
    }
}