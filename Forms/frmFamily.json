{
    "frmFamilyFORM": {
        "FORM": {
            "type": "Panel",
            "title": "Add/Edit/Delete Family",
            "pos": [
                10,
                10
            ],
            "size": [
                730,
                500
            ],
            "table": {
                "name": "tblFamily",
                "fields": [
                    "ID",
                    "ChurchID",
                    "FamilyName",
                    "MarriageStatus",
                    "Directory",
                    "Note"
                ],
                "orderby": "FamilyName"
            },
            "stylelist": [
                "CAPTION"
            ],
            "linkedform": {
                "frmFamilyAddress": {
                    "bindbtn": "btnFamilyAddress",
                    "controls": [
                        "Close",
                        "Navigation"
                    ],
                    "table": {
                        "name": "tblFamilyAddress",
                        "fields": [
                            "*"
                        ],
                        "condition": "FamilyID = {ID}",
                        "orderby": "Address,State"
                    },
                    "readonlyfields": [
                        "FamilyID"
                    ]
                },
                "frmFamilyContact": {
                    "bindbtn": "btnFamilyContact",
                    "controls": [
                        "Close",
                        "Navigation"
                    ],
                    "table": {
                        "name": "tblFamilyContact",
                        "fields": [
                            "*"
                        ],
                        "condition": "FamilyID = {ID}",
                        "orderby": "Type"
                    },
                    "readonlyfields": [
                        "FamilyID"
                    ]
                },
                "frmFamilyDate": {
                    "bindbtn": "btnFamilyDate",
                    "controls": [
                        "Close",
                        "Navigation"
                    ],
                    "table": {
                        "name": "tblFamilyDate",
                        "fields": [
                            "*"
                        ],
                        "condition": "FamilyID = {ID}",
                        "orderby": "Date"
                    },
                    "readonlyfields": [
                        "FamilyID"
                    ]
                },
                "frmPerson": {
                    "bindbtn": "btnPerson",
                    "controls": [
                        "Close",
                        "Navigation"
                    ],
                    "table": {
                        "name": "tblPerson",
                        "fields": [
                            "ID",
                            "ChurchID",
                            "FamilyID",
                            "FirstName",
                            "MiddleName",
                            "LastName",
                            "Status",
                            "Baptized",
                            "Confirmed",
                            "Member",
                            "AssociateMember",
                            "Note"
                        ],
                        "condition": "FamilyID = {ID}",
                        "orderby": "LastName"
                    },
                    "readonlyfields": [
                        "PersonID"
                    ]
                }
            }
        },
        "CONTROLS": {
            "btnFamilyAddress": {
                "name": "btnFamilyAddress",
                "type": "Button",
                "label": "Add/Edit/Delete Family Addresses",
                "pos": [
                    450,
                    30
                ]
            },
            "btnFamilyContact": {
                "type": "Button",
                "label": "Add/Edit/Delete Family Contacts",
                "pos": [
                    450,
                    60
                ],
                "name": "btnFamilyContact"
            },
            "btnFamilyDate": {
                "type": "Button",
                "label": "Add/EditDelete Family Date",
                "pos": [
                    450,
                    90
                ],
                "name": "btnFamilyDate"
            },
            "btnPerson": {
                "type": "Button",
                "label": "Add/Edit/Delete Family Members",
                "pos": [
                    450,
                    150
                ],
                "name": "btnPerson"
            },
            "lblChurchID": {
                "type": "StaticText",
                "label": "Church:",
                "pos": [
                    0,
                    0
                ],
                "name": "lblChurchID"
            },
            "ChurchID": {
                "type": "ComboBox",
                "lookupchoices": {
                    "name": "tblChurch",
                    "fields": [
                        "ID",
                        "Church"
                    ],
                    "orderby": "Church"
                },
                "pos": [
                    125,
                    0
                ],
                "size": [
                    300,
                    30
                ],
                "name": "ChurchID"
            },
            "lblFamilyName": {
                "type": "StaticText",
                "label": "Family Name:",
                "pos": [
                    0,
                    30
                ],
                "name": "lblFamilyName"
            },
            "FamilyName": {
                "type": "TextCtrl",
                "value": "",
                "pos": [
                    125,
                    30
                ],
                "size": [
                    300,
                    30
                ],
                "name": "FamilyName"
            },
            "lblMarriageStatus": {
                "type": "StaticText",
                "label": "Marriage Status:",
                "pos": [
                    0,
                    60
                ],
                "name": "lblMarriageStatus"
            },
            "MarriageStatus": {
                "type": "ComboBox",
                "pos": [
                    125,
                    60
                ],
                "size": [
                    300,
                    30
                ],
                "name": "MarriageStatus"
            },
            "lblDirectory": {
                "type": "StaticText",
                "label": "Directory?:",
                "pos": [
                    0,
                    90
                ],
                "name": "lblDirectory"
            },
            "Directory": {
                "type": "CheckBox",
                "pos": [
                    125,
                    90
                ],
                "size": [
                    300,
                    30
                ],
                "name": "Directory"
            },
            "lblNote": {
                "type": "StaticText",
                "label": "Note:",
                "pos": [
                    0,
                    120
                ],
                "name": "lblNote"
            },
            "Note": {
                "type": "MultiLine",
                "pos": [
                    125,
                    120
                ],
                "size": [
                    300,
                    100
                ],
                "name": "Note",
                "stylelist": [
                    "MULTILINE"
                ]
            }
        }
    }
}