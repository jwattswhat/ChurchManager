{
    "frmFamilyFORM": {
        "FORM": {
            "type": "Panel",
            "name": "frmFamily",
            "title": "Add/Edit/Delete Family",
            "table": {
                "name": "tblFamily",
                "fields": [
                    "ID",
                    "ChurchID",
                    "FamilyName",
                    "MarriageStatus",
                    "Directory",
                    "Note"
                ],
                "orderby": "FamilyName"
            },
            "stylelist": [
                "CAPTION"
            ],
            "linkedform": {
                "frmFamilyAddress": {
                    "name": "frmFamilyAddress",
                    "title": "frmFamilyAddress",
                    "controls": [
                        "Close",
                        "Navigation"
                    ],
                    "table": {
                        "name": "tblFamilyAddress",
                        "fields": [
                            "*"
                        ],
                        "condition": "FamilyID = {ID}",
                        "orderby": "Address,State"
                    },
                    "readonlyfields": [
                        "FamilyID"
                    ],
                    "fillonblank": [
                        "FamilyID",
                        "ID"
                    ]
                },
                "frmFamilyContact": {
                    "name": "frmFamilyContact",
                    "title": "frmFamilyConteact",
                    "controls": [
                        "Close",
                        "Navigation"
                    ],
                    "table": {
                        "name": "tblFamilyContact",
                        "fields": [
                            "*"
                        ],
                        "condition": "FamilyID = {ID}",
                        "orderby": "Type"
                    },
                    "readonlyfields": [
                        "FamilyID"
                    ],
                    "fillonblank": [
                        "FamilyID",
                        "ID"
                    ]
                },
                "frmFamilyDate": {
                    "name": "frmFamilyDate",
                    "title": "frmFamilyDate",
                    "controls": [
                        "Close",
                        "Navigation"
                    ],
                    "table": {
                        "name": "tblFamilyDate",
                        "fields": [
                            "*"
                        ],
                        "condition": "FamilyID = {ID}",
                        "orderby": "Date"
                    },
                    "readonlyfields": [
                        "FamilyID"
                    ],
                    "fillonblank": [
                        "FamilyID",
                        "ID"
                    ]
                },
                "frmPerson": {
                    "name": "frmPerson",
                    "title": "frmPerson",
                    "controls": [
                        "Close",
                        "Navigation"
                    ],
                    "table": {
                        "name": "tblPerson",
                        "fields": [
                            "ID",
                            "ChurchID",
                            "FamilyID",
                            "FirstName",
                            "MiddleName",
                            "LastName",
                            "Status",
                            "Baptized",
                            "Confirmed",
                            "Member",
                            "AssociateMember",
                            "Note"
                        ],
                        "condition": "FamilyID = {ID}",
                        "orderby": "LastName"
                    },
                    "readonlyfields": [
                        "PersonID"
                    ],
                    "fillonblank": [
                        "FamilyID",
                        "ID"
                    ]
                }
            },
            "posch": [
                -1,
                -1
            ],
            "sizech": [
                55,
                20
            ]
        },
        "CONTROLS": {
            "btnFamilyAddress": {
                "name": "btnFamilyAddress",
                "type": "Button",
                "label": "Add/Edit/Delete Family Addresses",
                "action": [
                    "openlinkedform",
                    "frmFamilyAddress"
                ],
                "posch": [
                    37,
                    1
                ]
            },
            "btnFamilyContact": {
                "type": "Button",
                "label": "Add/Edit/Delete Family Contacts",
                "name": "btnFamilyContact",
                "action": [
                    "openlinkedform",
                    "frmFamilyContact"
                ],
                "posch": [
                    37,
                    3
                ]
            },
            "btnFamilyDate": {
                "type": "Button",
                "label": "Add/EditDelete Family Date",
                "name": "btnFamilyDate",
                "action": [
                    "openlinkedform",
                    "frmFamilyDate"
                ],
                "posch": [
                    37,
                    5
                ]
            },
            "btnPerson": {
                "type": "Button",
                "label": "Add/Edit/Delete Family Members",
                "name": "btnPerson",
                "action": [
                    "openlinkedform",
                    "frmPerson"
                ],
                "posch": [
                    37,
                    7
                ]
            },
            "lblChurchID": {
                "type": "StaticText",
                "label": "Church:",
                "name": "lblChurchID",
                "posch": [
                    1,
                    1
                ]
            },
            "ChurchID": {
                "type": "ComboBox",
                "lookupchoices": {
                    "name": "tblChurch",
                    "fields": [
                        "ID",
                        "Church"
                    ],
                    "orderby": "Church"
                },
                "name": "ChurchID",
                "posch": [
                    10,
                    1
                ],
                "sizech": [
                    24,
                    2
                ]
            },
            "lblFamilyName": {
                "type": "StaticText",
                "label": "Family Name:",
                "name": "lblFamilyName",
                "posch": [
                    1,
                    3
                ]
            },
            "FamilyName": {
                "type": "TextCtrl",
                "value": "",
                "name": "FamilyName",
                "posch": [
                    10,
                    3
                ],
                "sizech": [
                    24,
                    2
                ]
            },
            "lblMarriageStatus": {
                "type": "StaticText",
                "label": "Marriage Status:",
                "name": "lblMarriageStatus",
                "posch": [
                    1,
                    5
                ]
            },
            "MarriageStatus": {
                "type": "ComboBox",
                "name": "MarriageStatus",
                "posch": [
                    10,
                    5
                ],
                "sizech": [
                    24,
                    2
                ]
            },
            "lblDirectory": {
                "type": "StaticText",
                "label": "Directory?:",
                "name": "lblDirectory",
                "posch": [
                    1,
                    7
                ]
            },
            "Directory": {
                "type": "CheckBox",
                "name": "Directory",
                "posch": [
                    10,
                    7
                ]
            },
            "lblNote": {
                "type": "StaticText",
                "label": "Note:",
                "name": "lblNote",
                "posch": [
                    0,
                    9
                ]
            },
            "Note": {
                "type": "MultiLine",
                "name": "Note",
                "stylelist": [
                    "MULTILINE"
                ],
                "posch": [
                    10,
                    9
                ],
                "sizech": [
                    24,
                    8
                ]
            }
        }
    }
}