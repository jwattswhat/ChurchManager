{
    "frmGivingRegisterFORM": {
        "FORM": {
            "name": "frmGivingRegister",
            "type": "Panel",
            "title": "frmGivingRegister: Giving Journal Edit Form",
            "table": {
                "name": "tblGivingRegister",
                "fields": [
                    "*"
                ],
                "condition": "LedgerID is NULL",
                "Orderby": "ID"
            },
            "stylelist": [
                "CAPTION"
            ],
            "posch": [
                -1,
                -1
            ],
            "sizech": [
                55,
                20
            ]
        },
        "CONTROLS": {
            "lblChurchID": {
                "type": "StaticText",
                "label": "Church:",
                "name": "lblChurchID",
                "posch": [
                    1,
                    1
                ]
            },
            "ChurchID": {
                "name": "ChurchID",
                "type": "ComboBox",
                "lookupchoices": {
                    "name": "tblChurch",
                    "fields": [
                        "ID",
                        "Church"
                    ],
                    "orderby": "Church"
                },
                "posch": [
                    9,
                    1
                ],
                "sizech": [
                    24,
                    2
                ]
            },
            "lblDate": {
                "type": "StaticText",
                "label": "Date:",
                "name": "lblDate",
                "posch": [
                    1,
                    3
                ]
            },
            "Date": {
                "type": "DatePickerCtrl",
                "name": "Date",
                "posch": [
                    9,
                    3
                ]
            },
            "lblFiscalYear": {
                "type": "StaticText",
                "label": "Fiscal Year:",
                "name": "lblFiscalYear",
                "posch": [
                    1,
                    5
                ]
            },
            "FiscalYear": {
                "type": "TextCtrl",
                "name": "FiscalYear",
                "posch": [
                    9,
                    5
                ],
                "sizech": [
                    4,
                    2
                ]
            },
            "lblEnvelopeID": {
                "type": "StaticText",
                "label": "Envelope:",
                "name": "lblEnvelopeID",
                "posch": [
                    1,
                    7
                ]
            },
            "EnvelopeID": {
                "type": "ComboBox",
                "name": "Envelope",
                "lookupchoices": {
                    "name": "tblEnvelope",
                    "fields": [
                        "ID",
                        "Envelope"
                    ],
                    "orderby": "Envelope"
                },
                "posch": [
                    9,
                    7
                ],
                "sizech": [
                    25,
                    2
                ]
            },
            "lblAmount": {
                "type": "StaticText",
                "label": "Amount:",
                "name": "lblAmount",
                "posch": [
                    1,
                    9
                ]
            },
            "Amount": {
                "type": "Currency",
                "name": "Amount",
                "posch": [
                    9,
                    9
                ],
                "sizech": [
                    10,
                    2
                ],
                "stylelist": [
                    "JUSTIFYRIGHT"
                ]
            },
            "lblDebitAccountID": {
                "type": "StaticText",
                "label": "Debit Account:",
                "name": "lblAccountID",
                "posch": [
                    1,
                    11
                ]
            },
            "DebitAccountID": {
                "type": "ComboBox",
                "name": "AccountID",
                "lookupchoices": {
                    "name": "tblFund",
                    "fields": [
                        "ID",
                        "CONCAT(AccountNumber,'-',Description,' (',AccountType,')')"
                    ],
                    "condition": "SummaryAccount <> 1",
                    "orderby": "AccountNumber"
                },
                "posch": [
                    9,
                    11
                ]
            },
            "lblCreditAccountID": {
                "type": "StaticText",
                "label": "Credit Account:",
                "name": "lblAccountID",
                "posch": [
                    1,
                    13
                ]
            },
            "CreditAccountID": {
                "type": "ComboBox",
                "name": "AccountID",
                "lookupchoices": {
                    "name": "tblFund",
                    "fields": [
                        "ID",
                        "CONCAT(AccountNumber,'-',Description,' (',AccountType,')')"
                    ],
                    "condition": "SummaryAccount <> 1",
                    "orderby": "AccountNumber"
                },
                "posch": [
                    9,
                    13
                ]
            },
            "lblNote": {
                "type": "StaticText",
                "label": "Note:",
                "name": "lblNote",
                "posch": [
                    1,
                    15
                ]
            },
            "Note": {
                "name": "Note",
                "type": "MultiLine",
                "stylelist": [
                    "MULTILINE",
                    "WORDWRAP"
                ],
                "posch": [
                    9,
                    15
                ],
                "sizech": [
                    24,
                    5
                ]
            }
        }
    }
}