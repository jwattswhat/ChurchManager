            "name": "frmMain",
            "type": "Dialog",
            "title": "frmGenerateWorshipPlanning: Worship Planning",
            "stylelist": [
                "CAPTION"
            ],
            "posch": [
                4,
                4
            ],
            "sizech": [
                29,
                16
            ],
            "theme": "churchmanager"
        },
        "CONTROLS": {
            "lblService": {
                "name": "lblService",
                "type": "StaticText",
                "label": "Service",
                "posch": [
                    2,
                    2
                ]
            },
            "ServiceID": {
                "name": "ServiceID",
                "type": "ComboBox",
                "lookupchoices": {
                    "name": "tblService",
                    "fields": [
                        "ID",
                        "DatetIME"
                    ],
                    "orderby": "DateTime DESC"
                },
                "posch": [
                    9,
                    2
                ],
                "tooltip": "Select the service."
            },
            "btnRun": {
                "name": "btnRun",
                "type": "Button",
                "label": "Run Report",
                "posch": [
                    2,
                    6
                ],
                "tooltip": "Generate the worship-planning worksheet for the selected service."
            }
        }
