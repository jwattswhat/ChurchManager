{
    "frmFundFORM": {
        "FORM": {
            "type": "Panel",
            "title": "frmFund: Fund Edit Form",
            "name": "frmFund",
            "table": {
                "name": "tblFund",
                "fields": [
                    "ID",
                    "ChurchID",
                    "AccountNumber",
                    "Description",
                    "Parent",
                    "AccountType",
                    "FiscalYear",
                    "SummaryAccount"
                ],
                "orderby": "FiscalYear DESC, AccountNumber"
            },
            "stylelist": [
                "CAPTION"
            ],
            "posch": [
                -1,
                -1
            ],
            "sizech": [
                35,
                25
            ]
        },
        "CONTROLS": {
            "lblChurchID": {
                "type": "StaticText",
                "label": "Church:",
                "name": "lblChurchID",
                "posch": [
                    1,
                    1
                ]
            },
            "ChurchID": {
                "type": "ComboBox",
                "lookupchoices": {
                    "ID": "ID",
                    "name": "tblChurch",
                    "fields": [
                        "ID",
                        "Church"
                    ],
                    "sort": "ChurchID"
                },
                "name": "ChurchID",
                "posch": [
                    9,
                    1
                ],
                "sizech": [
                    24,
                    2
                ]
            },
            "lblAccountNumber": {
                "type": "StaticText",
                "label": "Account Number:",
                "name": "lblAccountNumber",
                "posch": [
                    1,
                    3
                ]
            },
            "AccountNumber": {
                "type": "TextCtrl",
                "name": "AccountNumber",
                "posch": [
                    9,
                    3
                ],
                "sizech": [
                    24,
                    2
                ]
            },
            "lblDescription": {
                "type": "StaticText",
                "label": "Description:",
                "name": "lblDescription",
                "posch": [
                    1,
                    5
                ]
            },
            "Description": {
                "type": "TextCtrl",
                "name": "Description",
                "posch": [
                    9,
                    5
                ],
                "sizech": [
                    24,
                    2
                ]
            },
            "lblParent": {
                "type": "StaticText",
                "label": "ParentID:",
                "name": "lblParentID",
                "posch": [
                    1,
                    7
                ]
            },
            "Parent": {
                "type": "ComboBox",
                "name": "Parent",
                "lookupchoices":{
                    "ID": "ParentID",
                    "name":"tblFund",
                    "fields":["ID","AccountNumber","Description"],
                    "orderby":"AccountNumber"
                },
                "posch": [
                    9,
                    7
                ],
                "sizech": [
                    24,
                    2
                ]
            },
            "lblAccountType": {
                "type": "StaticText",
                "label": "Type:",
                "name": "lblAccountType",
                "posch": [
                    1,
                    9
                ]
            },
            "AccountType": {
                "type": "ComboBox",
                "name": "AccountType",
                "posch": [
                    9,
                    9
                ]
            },
            "lblFiscalYear":{
                "type":"StaticText",
                "name":"lblFiscalYear",
                "label":"Fiscal Year:",
                "posch":[1,11]
            },
            "FiscalYear":{
                "type":"TextCtrl",
                "name":"FiscalYear",
                "posch":[9,11],
                "sizech":[24,2]
            },
            "SummaryAccount":{
                "type":"CheckBox",
                "name":"SummaryAccount",
                "label":"Summary Account",
                "posch":[9,13]
            },
            "lblNote": {
                "type": "StaticText",
                "label": "Note:",
                "name": "lblNote",
                "posch": [
                    1,
                    15
                ]
            },
            "Note": {
                "type": "MultiLine",
                "stylelist": [
                    "MULTILINE"
                ],
                "name": "Note",
                "posch": [
                    9,
                    15
                ],
                "sizech": [
                    24,
                    8
                ]
            }
        }
    }
}