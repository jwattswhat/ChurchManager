{
    "frmDonorFORM":{
        "FORM":{
            "type":"Panel",
            "title":"frmDonor: Donor Edit Form",
            "name":"frmDonor",
            "table":{
                "name":"tblDonor",
                "fields":["*"],
                "orderby": "Name"
            },
            "posch":[-1,-1],
            "sizech": [50,30],
            "linkedform": {
                "frmDonorGift": {
                    "name": "frmDonorGift",
                    "type": "Panel",
                    "title": "frmDonorGift: Donor Gifts",
                    "table": {
                        "name": "tblDonorGift",
                        "fields": [
                            "*"
                        ],
                        "condition": "DonorID = {ID}",
                        "orderby":"Date DESC"
                    },
                    "controls": [
                        "Navigation",
                        "Close"
                    ],
                    "fillonblank": [
                        "DonorID",
                        "ID"
                    ],
                    "readonlyfields":["DonorID"]
                }
            }
         },
        "CONTROLS":{
            "lblChurchID":{
                "type":"StaticText",
                "name":"lblChurchID",
                "label":"Church:",
                "posch":[1,1]
            },
            "ChurchID": {
                "name": "ChurchID",
                "type": "ComboBox",
                "lookupchoices": {
                    "name": "tblChurch",
                    "fields": [
                        "ID",
                        "Church"
                    ],
                    "sort": "Church"
                },
                "posch": [
                    10,
                    1
                ],
                "sizech": [
                    20,
                    2
                ]
            },
