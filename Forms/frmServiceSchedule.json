{
    "frmServiceScheduleFORM": {
        "FORM": {
            "name": "frmServiceSchedule",
            "type": "Panel",
            "title": "frmServiceSchedule: ServiceSchedule Edit Form",
            "table": {
                "name": "tblService",
                "fields": [
                    "ID AS ServiceID",
                    "DateTime"
                ],
                "orderby": "DateTIme DESC"
            },
            "stylelist": [
                "CAPTION"
            ],
            "controls": [
                "Navigation",
                "Close"
            ],
            "posch": [
                -1,
                -1
            ],
            "sizech": [
                66,
                40
            ]
        },
        "CONTROLS": {
            "lblServiceID": {
                "name": "lblServiceID",
                "type": "StaticText",
                "label": "ServiceID:",
                "posch": [
                    1,
                    3
                ]
            },
            "ServiceID": {
                "name": "ServiceID",
                "type": "TextNumber",
                "format": "{:n}",
                "readonly": true,
                "posch": [
                    10,
                    3
                ],
                "sizech": [
                    24,
                    2
                ]
            },
            "lblDateTime": {
                "name": "lblDateTime",
                "type": "StaticText",
                "label": "Service Date:",
                "posch": [
                    1,
                    5
                ]
            },
            "DateTime": {
                "name": "DateTime",
                "type": "TextCtrl",
                "readonly": true,
                "posch": [
                    10,
                    5
                ],
                "sizech": [
                    24,
                    2
                ]
            },
            "btnRunSchedule": {
                "name": "btnRunSchedule",
                "type": "Button",
                "label": "Run Schedule",
                "posch": [
                    35,
                    5
                ]
            },
            "dvlParticipantSchedule": {
                "name": "dvlParticipantSchedule",
                "type": "DataViewListCtrl",
                "table": {
                    "name": "tblServiceRole",
                    "fields": [
                        "ID",
                        "ParticipantID",
                        "Role"
                    ],
                    "condition": "ServiceID = {ServiceID}"
                },
                "column": [
                    {
                        "name": "ParticipantID",
                        "label": "Participant",
                        "widthch": 30,
                        "lookup": {
                            "table": "tblParticipant",
                            "display": "Name",
                            "key": "ID"
                        }
                    },
                    {
                        "name": "Role",
                        "label": "Role",
                        "widthch": 20
                    }
                ],
                "posch": [
                    10,
                    7
                ],
                "sizech": [
                    41,
                    24
                ]
            }
        }
    }
}