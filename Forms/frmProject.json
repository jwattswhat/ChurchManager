{
    "frmProjectFORM": {
        "FORM": {
            "type": "Panel",
            "title": "frmProject: Project Edit Form",
            "name": "frmProject",
            "table": {
                "name": "tblProject",
                "fields": [
                    "*"
                ],
                "orderby": "Complete, Project"
            },
            "stylelist": [
                "CAPTION"
            ],
            "linkedform": {
                "frmTask": {
                    "name": "frmTask",
                    "type": "Panel",
