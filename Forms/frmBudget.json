                "posch": [9,3],
                "sizech":[4,2],
                "stylelist":["READONLY"]
            },
            "lblAccount": {
                "type": "StaticText",
                "label": "Account:",
                "name": "lblAccount",
                "posch": [
                    1,
                    5
                ]
            },
            "AccountNumber": {
                "type": "TextCtrl",
                "name": "AccountNumber",
                "posch": [
                    9,
                    5
                ],
                "sizech": [
                    24,
                    2
                ],
