            "CashBeginningBalance":{
                "type":"Currency",
                "name": "CashBeginningBalance",
                "posch": [9,9],
                "sizech": [8,2]
            },
            "lblBalance": {
                "type": "StaticText",
                "label": "Balance:",
                "name": "lblBalance",
                "posch": [
                    1,
                    11
                ]
            },
            "Balance": {
                "type": "Currency",
                "name": "Balance",
                "posch": [
                    9,
                    11
                ],
                "sizech": [
                    8,
                    2
                ]
