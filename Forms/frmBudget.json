{
    "frmBudgetFORM": {
        "FORM": {
            "type": "Panel",
            "title": "frmBudget: Budget Edit Form",
            "name": "frmBudget",
            "table": {
                "name": "tblFund",
                "fields": [
                    "ID",
                    "ChurchID",
                    "Description",
                    "FiscalYear",
                    "AccountNumber",
                    "CashBeginningBalance",
                    "Balance",
                    "Budget",
                    "Closed",
                    "Note"
                ],
                "orderby": "FiscalYear DESC, AccountNumber"
            },
            "stylelist": [
                "CAPTION"
            ],
            "posch": [
                -1,
                -1
            ],
            "sizech": [
                51,
                33
            ],
            "readonlyfields":["Balance","CashBeginningBalance"]
        },
        "CONTROLS": {
            "lblChurchID": {
                "type": "StaticText",
