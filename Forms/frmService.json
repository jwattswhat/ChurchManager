                "frmOptions": {
                    "name": "frmOptions",
                    "type": "Panel",
                    "title": "frmOptions: Change Lectionary",
                    "table": {
                        "name": "tblOptions",
                        "fields": [
                            "*"
                        ],
                        "condition": "OptionFor = 'Lectionary' and OptionType = 'Current'"
                    },
                    "controls": [
                        "Update",
                        "Close"
                    ],
                    "readonlyfields": [
                        "OptionFor",
                        "OptionType"
                    ]
                },
                "frmSermon": {
                    "name": "frmSermon",
