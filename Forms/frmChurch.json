{
    "frmChurchFORM": {
        "FORM": {
            "type": "Panel",
            "title": "frmChurch: Church Edit Form",
            "name": "frmChurch",
            "table": {
                "name": "tblChurch",
                "fields": [
                    "*"
                ],
                "orderby": "Church"
            },
            "linkedform": {
                "frmHymnal": {
                    "name": "frmHymnal",
                    "type": "Panel",
                    "title": "Hymnal Catalog",
                    "table": {"name": "tblHymnal", "fields": ["*"], "orderby": "Title"},
                    "controls": ["Navigation", "Update", "Delete", "Close"]
                },
                "frmLectionarySystem": {
                    "name": "frmLectionarySystem",
                    "type": "Panel",
                    "title": "Lectionary Systems",
                    "table": {"name": "tblLectionarySystem", "fields": ["*"], "orderby": "Name"},
                    "controls": ["Navigation", "Update", "Delete", "Close"]
                }
            },
            "stylelist": [
                "CAPTION"
            ],
            "posch": [
                -1,
                -1
            ],
            "sizech": [
                51,
                41
            ],
            "theme": "churchmanager"
        },
        "CONTROLS": {
            "lblChurch": {
                "name": "lblChurch",
                "type": "StaticText",
                "label": "Church:",
                "posch": [
                    1,
                    1
                ]
            },
            "Church": {
                "name": "Church",
                "type": "TextCtrl",
                "posch": [
                    6,
                    1
                ],
                "sizech": [
                    24,
                    2
                ],
                "tooltip": "Enter the church."
            },
            "lblAddress": {
                "name": "lblAddress",
                "type": "StaticText",
                "label": "Address:",
                "posch": [
                    1,
                    3
                ]
            },
            "Address": {
                "name": "Address",
                "type": "TextCtrl",
                "posch": [
                    6,
                    3
                ],
                "sizech": [
                    24,
                    2
                ],
                "tooltip": "Enter the address."
            },
            "Address2": {
                "name": "Address2",
                "type": "TextCtrl",
                "posch": [
                    6,
                    5
                ],
                "sizech": [
                    24,
                    2
                ],
                "tooltip": "Enter the second address line."
            },
            "lblCity": {
                "name": "lblCity",
                "type": "StaticText",
                "label": "City:",
                "posch": [
                    1,
                    7
                ]
            },
            "City": {
                "name": "City",
                "type": "TextCtrl",
                "value": "",
                "posch": [
                    6,
                    7
                ],
                "sizech": [
                    24,
                    2
                ],
                "tooltip": "Enter the city."
            },
            "lblState": {
                "name": "lblState",
