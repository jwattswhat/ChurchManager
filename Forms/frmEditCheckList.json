{
    "frmEditCheckListFORM": {
        "FORM": {
            "name": "frmEditChecklist",
            "type": "Panel",
            "title": "Edit Checklist",
            "table": {
                "name": "tblService",
                "fields": [
                    "ID",
                    "CheckList"
                ],
                "condition": "ID = {ID}"
            },
            "posch": [
                -1,
                -1
            ],
            "sizech": [
                35,
                25
            ],
            "stylelist": [
                "CAPTION"
            ],
            "controls": [
                "Navigation",
                "Close"
            ],
            "theme": "churchmanager"
        },
        "CONTROLS": {
            "lblCheckList": {
                "type": "StaticText",
                "label": "Checklist:",
                "posch": [
                    1,
                    3
                ],
                "name": "lblCheckList"
            },
            "CheckList": {
                "type": "CheckListEdit",
                "name": "CheckList",
                "posch": [
                    10,
                    3
                ],
                "sizech": [
                    20,
                    10
                ],
                "tooltip": "Edit the items in the check list."
            },
            "CheckListID": {
                "name": "CheckListID",
                "type": "ComboBox",
                "lookupchoices": {
                    "name": "tblCheckList",
                    "fields": [
                        "ID",
                        "Name"
                    ],
                    "sort": "Name"
                },
                "posch": [
                    10,
                    13
                ],
                "sizech": [
                    20,
                    3
                ],
                "tooltip": "Select the saved checklist used for the merge or replace operation."
            },
            "btnMerge": {
                "name": "btnMerge",
                "type": "Button",
                "posch": [
                    10,
                    15
                ],
                "label": "Merge",
                "action": [
                    "editchecklist",
                    "mergelist",
                    "CheckList",
                    "CheckListID"
                ],
                "tooltip": "Add the selected saved checklist items to the current checklist."
            },
            "btnReplace": {
                "name": "btnReplace",
                "type": "Button",
                "posch": [
                    15,
                    15
                ],
                "label": "Replace",
                "action": [
                    "editchecklist",
                    "replacelist",
                    "CheckList",
                    "CheckListID"
                ],
                "tooltip": "Replace the current checklist with the selected saved checklist."
            },
            "btnClear": {
                "name": "btnClear",
                "type": "Button",
                "posch": [
                    20,
                    15
                ],
                "label": "Clear",
                "action": [
                    "editchecklist",
                    "clearlist",
                    "CheckList"
                ],
                "tooltip": "Remove every item from the current checklist."
            }
        }
    }
}
