                "tooltip": "Select this if unlisted applies."
            },
            "lblNote": {
                "type": "StaticText",
                "label": "Note:",
                "name": "lblNote",
                "posch": [
                    1,
                    11
                ]
            },
            "Note": {
                "type": "MultiLine",
                "value": "",
                "stylelist": [
                    "MULTILINE"
                ],
                "name": "Note",
                "posch": [
                    10,
                    11
                ],
                "sizech": [
                    24,
                    8
                ],
                "tooltip": "Enter the note. Multiple lines are allowed."
