                "posch": [
                    1,
                    1
                ]
            },
            "FamilyID": {
                "type": "ComboBox",
                "name": "FamilyID",
                "lookupchoices": {
                    "name": "tblFamily",
                    "fields": [
                        "ID",
                        "FamilyName"
                    ]
                },
                "posch": [
                    10,
                    1
                ],
                "sizech": [
                    24,
                    2
                ],
                "tooltip": "Select the family."
            },
            "lblLabel": {
                "type": "StaticText",
