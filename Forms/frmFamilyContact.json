{
    "frmFamilyContactFORM": {
        "FORM": {
            "type": "Panel",
            "name": "frmFamilyContact",
            "title": "frmFamilyContact : Family Contact Edit Form",
            "table": {
                "name": "tblFamilyContact",
                "fields": [
                    "*"
                ]
            },
            "stylelist": [
                "CAPTION"
