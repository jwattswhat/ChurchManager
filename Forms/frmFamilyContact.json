                "name": "lblLabel",
                "posch": [
                    1,
                    3
                ]
            },
            "ContactLabel": {
                "type": "ComboBox",
                "name": "ContactLabel",
                "posch": [
                    10,
                    3
                ],
                "sizech": [
                    24,
                    2
                ],
                "tooltip": "Select the contact label."
            },
            "lblType": {
                "type": "StaticText",
                "label": "Type:",
                "name": "lblType",
                "posch": [
                    1,
                    5
                ]
            },
            "Type": {
                "type": "ComboBox",
                "name": "Type",
                "posch": [
                    10,
                    5
                ],
                "sizech": [
                    24,
                    2
                ],
                "tooltip": "Select the type."
            },
            "lblContact": {
                "type": "StaticText",
