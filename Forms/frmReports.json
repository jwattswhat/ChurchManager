{
    "frmReportsFORM": {
        "FORM": {
            "name": "frmReports",
            "type": "Panel",
            "title": "frmReports: Church Manager - Report Menu",
            "posch": [
                -1,
                -1
            ],
            "sizech": [
                45,
                40
            ],
            "stylelist": [
                "CAPTION"
            ]
        },
        "CONTROLS": {
            "lblChurchID": {
                "name": "lblChurchID",
                "type": "StaticText",
                "label": "Church :",
                "posch": [
                    1,
                    1
                ]
            },
            "ChurchID": {
                "name": "ChurchID",
                "type": "ComboBox",
                "lookupchoices": {
                    "name": "tblChurch",
                    "fields": [
                        "ID",
                        "Church"
                    ],
                    "sort": "Church"
                },
                "posch": [
                    7,
                    1
                ],
                "sizech": [
                    25,
                    30
                ],
                "value": "Life in Christ Lutheran Church",
                "tooltip": "Select the church."
            },
            "lblReports": {
                "name": "lblReports",
                "type": "StaticText",
                "posch": [
                    1,
                    4
                ],
                "label": "Report:"
            },
            "ReportID": {
                "name": "ReportID",
                "type": "ComboBox",
                "posch": [
                    7,
                    4
                ],
                "lookupchoices": {
                    "name": "tblReports",
                    "fields": [
                        "ID",
                        "Title",
                        "CONCAT('(',Report,')')"
                    ],
                    "condition": "Report NOT IN ('CFCA01','CFCR01','CFGR01','CMDN01','CMDN02')",
                    "orderby": "Title"
                },
                "action": [
                    "onchange",
                    "enablebuttons"
                ],
                "tooltip": "Select the report to run; its required parameters will be enabled."
            },
            "ParameterBox": {
                "name": "ParameterBox",
                "type": "StaticBox",
                "posch": [
                    1,
                    8
                ],
                "sizech": [
                    42,
                    12
                ],
                "label": "Parameters"
            },
            "lblService": {
                "name": "lblService",
                "type": "StaticText",
                "posch": [
                    2,
                    10
                ],
                "label": "Service:"
            },
            "ServiceID": {
                "name": "ServiceID",
                "type": "ComboBox",
                "posch": [
                    9,
                    10
                ],
                "lookupchoices": {
                    "name": "tblService",
                    "fields": [
                        "ID",
                        "DatetIME",
                        "LiturgicalDate"
                    ],
                    "orderby": "DateTime DESC"
                },
                "tooltip": "Select the service."
            },
            "lblPerson": {
                "name": "lblPerson",
                "type": "StaticText",
                "posch": [
                    2,
                    13
                ],
                "label": "Person:"
            },
            "PersonID": {
                "name": "PersonID",
                "type": "ComboBox",
                "posch": [
                    9,
                    13
                ],
                "lookupchoices": {
                    "name": "tblPerson",
                    "fields": [
                        "ID",
                        "LastName",
                        "FirstName"
                    ],
                    "orderby": "LastName,FirstName"
                },
                "tooltip": "Select the person."
            },
            "lblHymn": {
                "name": "lblHymn",
                "type": "StaticText",
                "posch": [
                    2,
                    16
                ],
                "label": "Hymn:"
            },
            "HymnID": {
                "name": "HymnID",
                "type": "ComboBox",
                "posch": [
                    9,
                    16
                ],
                "lookupchoices": {
                    "name": "tblHymn",
                    "fields": [
                        "ID",
                        "Hymn",
                        "Title"
                    ],
                    "orderby": "Hymn"
                },
                "tooltip": "Select the hymn."
            },
            "lblStartDate": {
                "name": "lblStartDate",
                "type": "StaticText",
                "posch": [
                    2,
                    19
                ],
                "label": "Start Date:"
            },
            "StartDate": {
                "name": "StartDate",
                "type": "DatePickerCtrl",
                "posch": [
                    9,
                    19
                ],
                "format": "%Y/%m/%d",
                "tooltip": "Select the start date."
            },
            "lblEndDate": {
                "name": "lblEndDate",
                "type": "StaticText",
                "posch": [
                    2,
                    22
                ],
                "label": "End Date:"
            },
            "EndDate": {
                "name": "EndDate",
                "type": "DatePickerCtrl",
                "posch": [
                    9,
                    22
                ],
                "format": "%Y/%m/%d",
                "tooltip": "Select the end date."
            },
            "lblAttendanceType": {
                "name": "lblAttendanceType",
                "type": "StaticText",
                "posch": [
                    2,
                    25
                ],
                "label": "Attend Type:"
            },
            "AttendanceType": {
                "name": "AttendanceType",
                "type": "ComboBox",
                "posch": [
                    9,
                    25
                ],
                "sizech": [
                    30,
                    3
                ],
                "value": "All",
                "tooltip": "Select the attendance type."
            },
            "lblDetail": {
                "name": "lblDetail",
                "type": "StaticText",
                "posch": [
                    2,
                    28
                ],
                "label": "Detail:"
            },
            "Detail": {
                "name": "Detail",
                "type": "CheckBox",
                "posch": [
                    9,
                    28
                ],
                "value": 0,
                "tooltip": "Include detailed information in reports that support it."
            },
            "lblProjectID": {
                "name": "lblProjectID",
                "type": "StaticText",
                "posch": [
                    2,
                    31
                ],
                "label": "Project:"
            },
            "ProjectID": {
                "name": "ProjectID",
                "type": "ComboBox",
                "posch": [
                    9,
                    31
                ],
                "lookupchoices": {
                    "name": "tblProject",
                    "fields": [
                        "ID",
                        "Description"
                    ],
                    "orderby": "Description"
                },
                "value": "All",
                "tooltip": "Select the project."
            },
            "btnRun": {
                "name": "btnRun",
                "type": "Button",
                "label": "Run Report",
                "posch": [
                    35,
                    33
                ],
                "tooltip": "Run the selected report using the entered parameters."
            }
        }
    }
}
