    <datasourcesManager ClassName="LimeReport::DataSourceManager" Type="Object">
      <objectName Type="QString">datasources</objectName>
      <connections Type="Collection">
        <item ClassName="LimeReport::ConnectionDesc" Type="Object">
          <objectName Type="QString"></objectName>
          <name Type="QString">ChurchDB</name>
          <driver Type="QString">QMYSQL</driver>
          <databaseName Type="QString"></databaseName>
          <userName Type="QString"></userName>
          <password Type="QString" Value=""/>
          <host Type="QString"></host>
          <autoconnect Type="bool" Value="1"/>
          <keepDBCredentials Type="bool" Value="1"/>
          <port Type="int" Value="-1"/>
        </item>
      </connections>
      <queries Type="Collection">
        <item ClassName="LimeReport::QueryDesc" Type="Object">
          <objectName Type="QString"></objectName>
          <queryName Type="QString">church</queryName>
          <queryText Type="QString">SELECT * FROM rpt_church_identity WHERE ID = $V{churchID};</queryText>
          <connectionName Type="QString">ChurchDB</connectionName>
        </item>
        <item ClassName="LimeReport::QueryDesc" Type="Object">
          <objectName Type="QString"></objectName>
          <queryName Type="QString">person</queryName>
          <queryText Type="QString">SELECT DISTINCT LastName FROM rpt_membership_person
WHERE ChurchID = $V{churchID} AND Member =  1
ORDER BY LastName;</queryText>
          <connectionName Type="QString">ChurchDB</connectionName>
        </item>
      </queries>
      <subqueries Type="Collection">
        <item ClassName="LimeReport::SubQueryDesc" Type="Object">
          <objectName Type="QString"></objectName>
          <queryName Type="QString">phonenumber</queryName>
          <queryText Type="QString">SELECT P.FamilyID, P.LastName, P.FirstName, P.Member, C.Type, C.ContactLabel, C.Contact, C.Unlisted 
FROM rpt_person_contact AS C
LEFT JOIN rpt_membership_person AS P ON P.ID = C.PersonID
WHERE (P.LastName = $D{person.LastName} AND Unlisted = 0) AND P.ChurchID = $V{churchID}
ORDER BY P.FirstName, C.Type</queryText>
          <connectionName Type="QString">ChurchDB</connectionName>
          <master Type="QString">Person</master>
        </item>
        <item ClassName="LimeReport::SubQueryDesc" Type="Object">
          <objectName Type="QString"></objectName>
          <queryName Type="QString">personaddress</queryName>
          <queryText Type="QString">SELECT 	P.ID,
	P.FamilyID, 
	P.LastName, 
	P.FirstName, 
	P.Member, 
	A.AddressLabel, 
	A.Address, 
	A.Address2,
	A.City,
	A.State,
	A.Zip, 
	A.Unlisted 
FROM rpt_person_address AS A
LEFT JOIN rpt_membership_person AS P
	ON P.ID = A.PersonID
WHERE (P.LastName = $D{person.LastName} AND A.Unlisted = 0)
ORDER BY P.FirstName, A.AddressLabel
</queryText>
          <connectionName Type="QString">ChurchDB</connectionName>
          <master Type="QString">person</master>
        </item>
        <item ClassName="LimeReport::SubQueryDesc" Type="Object">
          <objectName Type="QString"></objectName>
          <queryName Type="QString">familyaddress</queryName>
          <queryText Type="QString">SELECT 	F.ID, 
	F.FamilyName, 
	A.FamilyID,
	A.AddressLabel, 
	A.Address,
	A.Address2, 
	A.City, 
	A.State, 
	A.Zip, 
	A.Unlisted
FROM rpt_family_address AS A
LEFT JOIN rpt_directory_family AS F
	ON F.ID = A.FamilyID
WHERE INSTR(F.FamilyName, $D{Person.LastName})  AND A.Unlisted = 0

</queryText>
          <connectionName Type="QString">ChurchDB</connectionName>
          <master Type="QString">person</master>
        </item>
        <item ClassName="LimeReport::SubQueryDesc" Type="Object">
          <objectName Type="QString"></objectName>
          <queryName Type="QString">familyphonenumber</queryName>
          <queryText Type="QString">SELECT 	F.ID, 
	F.FamilyName, 
	C.Type, 
	C.ContactLabel, 
	C.Contact, 
	C.Unlisted 
FROM rpt_family_contact AS C
LEFT JOIN rpt_directory_family AS F 
	ON F.ID = C.FamilyID
WHERE INSTR(F.FamilyName, $D{Person.LastName}) AND C.Unlisted = 0 AND F.Directory=True
ORDER BY F.FamilyName</queryText>
          <connectionName Type="QString">ChurchDB</connectionName>
          <master Type="QString">Person</master>
        </item>
      </subqueries>
      <subproxies Type="Collection"/>
      <variables Type="Collection">
        <item ClassName="LimeReport::VarDesc" Type="Object">
          <objectName Type="QString"></objectName>
          <name Type="QString">churchID</name>
          <value Type="QString">0</value>
          <isMandatory Type="bool" Value="1"/>
          <dataType Type="int" Value="3"/>
        </item>
      </variables>
      <csvs Type="Collection"/>
