    <datasourcesManager Type="Object" ClassName="LimeReport::DataSourceManager">
      <objectName Type="QString">datasources</objectName>
      <connections Type="Collection">
        <item Type="Object" ClassName="LimeReport::ConnectionDesc">
          <objectName Type="QString"></objectName>
          <name Type="QString">ChurchDB</name>
          <driver Type="QString">QMYSQL</driver>
          <databaseName Type="QString">ChurchDB</databaseName>
          <userName Type="QString">church</userName>
          <password Type="QString" Value="dJlfSRL7RII="/>
          <host Type="QString"></host>
          <autoconnect Type="bool" Value="1"/>
          <keepDBCredentials Type="bool" Value="1"/>
          <port Type="int" Value="-1"/>
        </item>
      </connections>
      <queries Type="Collection">
        <item Type="Object" ClassName="LimeReport::QueryDesc">
          <objectName Type="QString"></objectName>
          <queryName Type="QString">church</queryName>
          <queryText Type="QString">SELECT * FROM tblChurch WHERE ID = $V{ChurchID};</queryText>
          <connectionName Type="QString">ChurchDB</connectionName>
        </item>
        <item Type="Object" ClassName="LimeReport::QueryDesc">
          <objectName Type="QString"></objectName>
          <queryName Type="QString">sermon</queryName>
          <queryText Type="QString">SELECT sr.Sermon FROM tblSermon AS sr
INNER JOIN tblService AS s
ON sr.ID = s.SermonID AND s.ID = $V{ServiceID};</queryText>
          <connectionName Type="QString">ChurchDB</connectionName>
        </item>
        <item Type="Object" ClassName="LimeReport::QueryDesc">
          <objectName Type="QString"></objectName>
          <queryName Type="QString">service</queryName>
          <queryText Type="QString">SELECT * FROM tblservice WHERE ID = $V{ServiceID} AND ChurchID = $V{ChurchID};</queryText>
          <connectionName Type="QString">ChurchDB</connectionName>
        </item>
      </queries>
      <subqueries Type="Collection">
        <item Type="Object" ClassName="LimeReport::SubQueryDesc">
          <objectName Type="QString"></objectName>
          <queryName Type="QString">propers</queryName>
          <queryText Type="QString">SELECT p.* 
FROM tblPropers AS p
INNER JOIN tblService as s 
ON p.ID = $D{service.PropersID};
</queryText>
          <connectionName Type="QString">ChurchDB</connectionName>
          <master Type="QString">service</master>
        </item>
        <item Type="Object" ClassName="LimeReport::SubQueryDesc">
          <objectName Type="QString"></objectName>
          <queryName Type="QString">hymnusage</queryName>
          <queryText Type="QString">SELECT u.UsedAs, h.Hymn, h.Title, u.Note FROM tblHymnUsage as u
INNER JOIN tblHymn as h 
ON u.HymnID=h.ID and u.ServiceID = $D{service.ID};</queryText>
          <connectionName Type="QString">ChurchDB</connectionName>
          <master Type="QString">service</master>
        </item>
        <item Type="Object" ClassName="LimeReport::SubQueryDesc">
          <objectName Type="QString"></objectName>
          <queryName Type="QString">reading</queryName>
          <queryText Type="QString">SELECT r.* FROM tblReading AS r 
INNER JOIN tblPropers AS p
on  $D{service.PropersID} = p.ID AND r.PropersID = p.ID;</queryText>
          <connectionName Type="QString">ChurchDB</connectionName>
          <master Type="QString">service</master>
        </item>
        <item Type="Object" ClassName="LimeReport::SubQueryDesc">
          <objectName Type="QString"></objectName>
          <queryName Type="QString">altreading</queryName>
          <queryText Type="QString">SELECT * FROM tblAltReading
WHERE ServiceID = $D{service.ID};</queryText>
          <connectionName Type="QString">ChurchDB</connectionName>
          <master Type="QString">service</master>
        </item>
        <item Type="Object" ClassName="LimeReport::SubQueryDesc">
          <objectName Type="QString"></objectName>
          <queryName Type="QString">servicerole</queryName>
          <queryText Type="QString">SELECT sr.ServiceID, p.Name, sr.Role
FROM tblServiceRole as sr
INNER JOIN tblParticipant as p
ON sr.ParticipantID = p.ID
WHERE sr.ServiceID = $V{ServiceID};</queryText>
          <connectionName Type="QString">ChurchDB</connectionName>
          <master Type="QString">service</master>
        </item>
      </subqueries>
      <subproxies Type="Collection"/>
      <variables Type="Collection">
        <item Type="Object" ClassName="LimeReport::VarDesc">
          <objectName Type="QString"></objectName>
          <name Type="QString">ChurchID</name>
          <value Type="QString">0</value>
          <isMandatory Type="bool" Value="1"/>
          <dataType Type="int" Value="3"/>
        </item>
        <item Type="Object" ClassName="LimeReport::VarDesc">
          <objectName Type="QString"></objectName>
          <name Type="QString">ServiceID</name>
          <value Type="QString">20</value>
          <isMandatory Type="bool" Value="1"/>
          <dataType Type="int" Value="3"/>
        </item>
      </variables>
