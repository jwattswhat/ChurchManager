          <driver Type="QString">QMYSQL</driver>
          <databaseName Type="QString">ChurchDB</databaseName>
          <userName Type="QString">church</userName>
          <password Type="QString" Value="dJlfSRL7RII="/>
          <host Type="QString">192.168.3.200</host>
          <autoconnect Type="bool" Value="1"/>
          <keepDBCredentials Type="bool" Value="1"/>
          <port Type="int" Value="-1"/>
        </item>
      </connections>
      <queries Type="Collection">
        <item ClassName="LimeReport::QueryDesc" Type="Object">
          <objectName Type="QString"></objectName>
          <queryName Type="QString">person</queryName>
          <queryText Type="QString">SELECT * FROM tblPerson WHERE Member = True ORDER BY LastName, FirstName ;</queryText>
          <connectionName Type="QString">churchdb</connectionName>
        </item>
      </queries>
      <subqueries Type="Collection">
        <item ClassName="LimeReport::SubQueryDesc" Type="Object">
          <objectName Type="QString"></objectName>
          <queryName Type="QString">persondate</queryName>
          <queryText Type="QString">SELECT * FROM tblPersonDate WHERE PersonID = $D{person.ID};</queryText>
          <connectionName Type="QString">churchdb</connectionName>
          <master Type="QString">person</master>
        </item>
        <item ClassName="LimeReport::SubQueryDesc" Type="Object">
          <objectName Type="QString"></objectName>
          <queryName Type="QString">personaddress</queryName>
          <queryText Type="QString">SELECT * FROM tblPersonAddress WHERE PersonID = $D{person.ID} AND Unlisted = False;</queryText>
          <connectionName Type="QString">churchdb</connectionName>
          <master Type="QString">person</master>
        </item>
        <item ClassName="LimeReport::SubQueryDesc" Type="Object">
          <objectName Type="QString"></objectName>
          <queryName Type="QString">personcontact</queryName>
          <queryText Type="QString">SELECT * FROM tblPersonContact WHERE PersonID = $D{person.ID} AND Unlisted = False;</queryText>
          <connectionName Type="QString">churchdb</connectionName>
          <master Type="QString">person</master>
        </item>
      </subqueries>
