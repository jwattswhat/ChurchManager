    <datasourcesManager ClassName="LimeReport::DataSourceManager" Type="Object">
      <objectName Type="QString">datasources</objectName>
      <connections Type="Collection">
        <item ClassName="LimeReport::ConnectionDesc" Type="Object">
          <objectName Type="QString"></objectName>
          <name Type="QString">churchdb</name>
          <driver Type="QString">QMYSQL</driver>
          <databaseName Type="QString"></databaseName>
          <userName Type="QString"></userName>
          <password Value="" Type="QString"/>
          <host Type="QString"></host>
          <autoconnect Value="1" Type="bool"/>
          <keepDBCredentials Value="1" Type="bool"/>
          <port Value="-1" Type="int"/>
        </item>
      </connections>
      <queries Type="Collection">
        <item ClassName="LimeReport::QueryDesc" Type="Object">
          <objectName Type="QString"></objectName>
          <queryName Type="QString">church</queryName>
          <queryText Type="QString">SELECT * FROM rpt_church_identity WHERE ID = $V{ChurchID};</queryText>
          <connectionName Type="QString">churchdb</connectionName>
        </item>
        <item ClassName="LimeReport::QueryDesc" Type="Object">
          <objectName Type="QString"></objectName>
          <queryName Type="QString">project</queryName>
          <queryText Type="QString">SELECT p.ID, p.ChurchID, p.Project, p.Description, p.Complete,p.CompletionDate, p.ProjectCategory, p.Priority, p.StartDate,p.EndDate,p.Note, p.assignedto,p.assignedtotext, IF (p.AssignedToText IS NULL, CONCAT(pe.FirstName," ",pe.LastName), p.AssignedToText) AS Coordinator
FROM rpt_project AS p
LEFT JOIN rpt_membership_person AS pe
ON p.AssignedTo = pe.ID
WHERE p.ChurchID = $V{ChurchID} AND p.Complete = $V{Complete} AND IF ($V{ProjectID}="All",1,p.ID = $V{ProjectID})
ORDER BY p.Priority, p.StartDate DESC;
</queryText>
          <connectionName Type="QString">churchdb</connectionName>
        </item>
      </queries>
      <subqueries Type="Collection">
        <item ClassName="LimeReport::SubQueryDesc" Type="Object">
          <objectName Type="QString"></objectName>
          <queryName Type="QString">taskworkers</queryName>
          <queryText Type="QString">SELECT t.PersonID, t.PersonText, p.FirstName, p.LastName, IF(t.PersonText IS NULL, CONCAT(p.FirstName," ",p.LastName),t.PersonText) AS Worker
FROM rpt_task_worker AS t
LEFT JOIN rpt_membership_person AS p
ON t.PersonID = p.ID
WHERE t.TaskID = $D{task.ID};</queryText>
          <connectionName Type="QString">churchdb</connectionName>
          <master Type="QString">task</master>
        </item>
        <item ClassName="LimeReport::SubQueryDesc" Type="Object">
          <objectName Type="QString"></objectName>
          <queryName Type="QString">task</queryName>
          <queryText Type="QString">SELECT * FROM rpt_task WHERE ProjectID = $D{project.ID} AND $V{Detail} = "True" ORDER BY Complete, Priority, StartDate;</queryText>
          <connectionName Type="QString">churchdb</connectionName>
          <master Type="QString">project</master>
        </item>
      </subqueries>
      <subproxies Type="Collection"/>
      <variables Type="Collection">
        <item ClassName="LimeReport::VarDesc" Type="Object">
          <objectName Type="QString"></objectName>
          <name Type="QString">ChurchID</name>
          <value Type="QString">0</value>
          <isMandatory Value="1" Type="bool"/>
          <dataType Value="3" Type="int"/>
        </item>
        <item ClassName="LimeReport::VarDesc" Type="Object">
          <objectName Type="QString"></objectName>
          <name Type="QString">Complete</name>
          <value Type="QString">0</value>
          <isMandatory Value="1" Type="bool"/>
          <dataType Value="3" Type="int"/>
        </item>
        <item ClassName="LimeReport::VarDesc" Type="Object">
          <objectName Type="QString"></objectName>
          <name Type="QString">ProjectID</name>
          <value Type="QString">All</value>
          <isMandatory Value="0" Type="bool"/>
          <dataType Value="1" Type="int"/>
        </item>
        <item ClassName="LimeReport::VarDesc" Type="Object">
          <objectName Type="QString"></objectName>
          <name Type="QString">Detail</name>
          <value Type="QString">False</value>
          <isMandatory Value="0" Type="bool"/>
          <dataType Value="3" Type="int"/>
        </item>
      </variables>
      <csvs Type="Collection"/>
