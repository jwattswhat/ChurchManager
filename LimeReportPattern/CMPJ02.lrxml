          <objectName Type="QString"></objectName>
          <queryName Type="QString">assignment</queryName>
          <queryText Type="QString">SELECT UNIQUE(AssignedTo) FROM tblProject WHERE ChurchID = $V{churchID} ORDER BY AssignedTo;</queryText>
          <connectionName Type="QString">churchdb</connectionName>
        </item>
        <item ClassName="LimeReport::QueryDesc" Type="Object">
          <objectName Type="QString"></objectName>
          <queryName Type="QString">church</queryName>
          <queryText Type="QString">SELECT * FROM tblChurch WHERE ID = $V{churchID};</queryText>
          <connectionName Type="QString">churchdb</connectionName>
        </item>
      </queries>
      <subqueries Type="Collection">
        <item ClassName="LimeReport::SubQueryDesc" Type="Object">
          <objectName Type="QString"></objectName>
          <queryName Type="QString">task</queryName>
          <queryText Type="QString">SELECT * FROM tblTask WHERE ProjectID = $D{project.ID} ORDER BY Priority;</queryText>
          <connectionName Type="QString">churchdb</connectionName>
          <master Type="QString">project</master>
        </item>
        <item ClassName="LimeReport::SubQueryDesc" Type="Object">
          <objectName Type="QString"></objectName>
          <queryName Type="QString">project</queryName>
          <queryText Type="QString">SELECT * FROM tblProject WHERE ChurchID = $V{churchID} AND AssignedTo = $D{assignment.AssignedTo} ORDER BY Priority, EndDate;</queryText>
          <connectionName Type="QString">churchdb</connectionName>
          <master Type="QString">assignment</master>
        </item>
