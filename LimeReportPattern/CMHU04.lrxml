          <objectName Type="QString"></objectName>
          <queryName Type="QString">church</queryName>
          <queryText Type="QString">SELECT * FROM rpt_church_identity
WHERE ID = $V{ChurchID};</queryText>
          <connectionName Type="QString">Church</connectionName>
        </item>
        <item Type="Object" ClassName="LimeReport::QueryDesc">
          <objectName Type="QString"></objectName>
          <queryName Type="QString">hymns</queryName>
          <queryText Type="QString">SELECT hu.UsedAs, h.Hymn,h.Title ,s.DateTime AS datetime, s.LiturgicalDate, p.Season
FROM rpt_hymn_usage AS hu
JOIN rpt_hymn AS h
ON hu.HymnID = h.ID
JOIN rpt_service as s
ON hu.ServiceID = s.ID
JOIN rpt_propers as p
ON s.PropersID = p.ID
WHERE s.ChurchID = $V{ChurchID} AND DATE(s.DateTime) > $V{StartDate}
ORDER BY h.Hymn, s.DateTime DESC </queryText>
          <connectionName Type="QString">Church</connectionName>
        </item>
      </queries>
      <subqueries Type="Collection"/>
      <subproxies Type="Collection"/>
      <variables Type="Collection">
        <item Type="Object" ClassName="LimeReport::VarDesc">
          <objectName Type="QString"></objectName>
          <name Type="QString">ChurchID</name>
          <value Type="QString">0</value>
          <isMandatory Type="bool" Value="1"/>
          <dataType Type="int" Value="3"/>
        </item>
        <item Type="Object" ClassName="LimeReport::VarDesc">
          <objectName Type="QString"></objectName>
          <name Type="QString">StartDate</name>
          <value Type="QString">2023/02/22</value>
          <isMandatory Type="bool" Value="1"/>
          <dataType Type="int" Value="5"/>
        </item>
      </variables>
      <csvs Type="Collection"/>
    </datasourcesManager>
    <scriptContext Type="Object" ClassName="LimeReport::ScriptEngineContext">
      <objectName Type="QString"></objectName>
      <dialogs Type="Collection"/>
      <initScript Type="QString">function addDate(date, dayCount){
  var lDate = new Date(date);
  lDate.setDate(lDate.getDate()+dayCount);
  return lDate;
}</initScript>
    </scriptContext>
    <suppressFieldAndVarError Type="bool" Value="0"/>
    <translation Type="Translation"/>
  </object>
</Report>
