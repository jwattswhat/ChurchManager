        <item Type="Object" ClassName="LimeReport::QueryDesc">
          <objectName Type="QString"></objectName>
          <queryName Type="QString">complete</queryName>
          <queryText Type="QString">SELECT UNIQUE Complete FROM rpt_enhancement ORDER BY Complete;</queryText>
          <connectionName Type="QString">ChurchDB</connectionName>
        </item>
      </queries>
      <subqueries Type="Collection">
        <item Type="Object" ClassName="LimeReport::SubQueryDesc">
          <objectName Type="QString"></objectName>
          <queryName Type="QString">enhancement</queryName>
          <queryText Type="QString">SELECT * FROM rpt_enhancement WHERE Complete = $D{complete.Complete} ORDER BY Priority, CompleteDate</queryText>
          <connectionName Type="QString">ChurchDB</connectionName>
          <master Type="QString">complete</master>
        </item>
