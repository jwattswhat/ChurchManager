        <item Type="Object" ClassName="LimeReport::ConnectionDesc">
          <objectName Type="QString"></objectName>
          <name Type="QString">ChurchDB</name>
          <driver Type="QString">QMYSQL</driver>
          <databaseName Type="QString">ChurchDB</databaseName>
          <userName Type="QString">church</userName>
          <password Type="QString" Value="dJlfSRL7RII="/>
          <host Type="QString"></host>
          <autoconnect Type="bool" Value="1"/>
          <keepDBCredentials Type="bool" Value="1"/>
          <port Type="int" Value="-1"/>
        </item>
      </connections>
      <queries Type="Collection">
        <item Type="Object" ClassName="LimeReport::QueryDesc">
          <objectName Type="QString"></objectName>
          <queryName Type="QString">church</queryName>
          <queryText Type="QString">SELECT * FROM tblChurch WHERE ID = $V{ChurchID};</queryText>
          <connectionName Type="QString">ChurchDB</connectionName>
        </item>
        <item Type="Object" ClassName="LimeReport::QueryDesc">
          <objectName Type="QString"></objectName>
          <queryName Type="QString">person</queryName>
          <queryText Type="QString">SELECT p.ID, p.FirstName, p.LastName, p.Status, p.Member, d.PersonID, d.DateType, d.Date, d.Note
FROM tblPerson AS p
LEFT JOIN tblPersonDate AS d
ON p.ID = d.PersonID
WHERE p.ID = d.PersonID AND (d.DateType = "Transfer Out" OR d.DateType = "Transfer In") AND (YEAR(d.Date) = YEAR(NOW()))
ORDER BY p.LastName, p.FirstName, d.Date ASC</queryText>
          <connectionName Type="QString">ChurchDB</connectionName>
        </item>
      </queries>
      <subqueries Type="Collection"/>
      <subproxies Type="Collection"/>
      <variables Type="Collection">
        <item Type="Object" ClassName="LimeReport::VarDesc">
          <objectName Type="QString"></objectName>
          <name Type="QString">ChurchID</name>
          <value Type="QString">0</value>
          <isMandatory Type="bool" Value="1"/>
          <dataType Type="int" Value="3"/>
        </item>
      </variables>
      <csvs Type="Collection"/>
    </datasourcesManager>
