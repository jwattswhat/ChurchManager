    <datasourcesManager ClassName="LimeReport::DataSourceManager" Type="Object">
      <objectName Type="QString">datasources</objectName>
      <connections Type="Collection">
        <item ClassName="LimeReport::ConnectionDesc" Type="Object">
          <objectName Type="QString"></objectName>
          <name Type="QString">ChurchDB</name>
          <driver Type="QString">QMYSQL</driver>
          <databaseName Type="QString"></databaseName>
          <userName Type="QString"></userName>
          <password Value="" Type="QString"/>
          <host Type="QString"></host>
          <autoconnect Value="1" Type="bool"/>
          <keepDBCredentials Value="1" Type="bool"/>
          <port Value="-1" Type="int"/>
        </item>
      </connections>
      <queries Type="Collection">
        <item ClassName="LimeReport::QueryDesc" Type="Object">
          <objectName Type="QString"></objectName>
          <queryName Type="QString">OfficeVisit</queryName>
          <queryText Type="QString">SELECT COUNT(ID) FROM rpt_attendance_event
WHERE AttendanceType = "Visit" AND Description LIKE "%Office Visit%";</queryText>
          <connectionName Type="QString">ChurchDB</connectionName>
        </item>
        <item ClassName="LimeReport::QueryDesc" Type="Object">
          <objectName Type="QString"></objectName>
          <queryName Type="QString">hospitalvisits</queryName>
          <queryText Type="QString">SELECT COUNT(ID) FROM rpt_attendance_event
WHERE AttendanceType = "Visit" AND Description = "Hospital Visit";</queryText>
          <connectionName Type="QString">ChurchDB</connectionName>
        </item>
        <item ClassName="LimeReport::QueryDesc" Type="Object">
          <objectName Type="QString"></objectName>
          <queryName Type="QString">homevisit</queryName>
          <queryText Type="QString">SELECT COUNT(ID) FROM rpt_attendance_event
WHERE AttendanceType = "Visit" AND Description LIKE "%Home Visit%"

</queryText>
          <connectionName Type="QString">ChurchDB</connectionName>
        </item>
        <item ClassName="LimeReport::QueryDesc" Type="Object">
          <objectName Type="QString"></objectName>
          <queryName Type="QString">personatteneance</queryName>
          <queryText Type="QString">SELECT 
COUNT(DISTINCT a.PersonID) AS people
FROM rpt_attendance AS a
LEFT JOIN rpt_membership_person AS p
ON p.ID = a.PersonID
LEFT JOIN rpt_attendance_event AS ae
ON ae.ID = a.AttendanceEventID
LEFT JOIN rpt_service AS s
ON s.ID = ae.ServiceID
WHERE ae.ChurchID = $V{ChurchID}
AND p.Member = 1
AND ae.AttendanceType="Worship Service"
AND (IF(ae.DateTime=NULL,ae.DateTime,s.DateTime) BETWEEN $V{StartDate} AND $V{EndDate})
</queryText>
          <connectionName Type="QString">ChurchDB</connectionName>
        </item>
        <item ClassName="LimeReport::QueryDesc" Type="Object">
          <objectName Type="QString"></objectName>
          <queryName Type="QString">services</queryName>
          <queryText Type="QString">SELECT COUNT(*)
FROM rpt_service
WHERE ChurchID = $V{ChurchID}
AND DateTime BETWEEN $V{StartDate} AND $V{EndDate}
</queryText>
          <connectionName Type="QString">ChurchDB</connectionName>
        </item>
        <item ClassName="LimeReport::QueryDesc" Type="Object">
          <objectName Type="QString"></objectName>
          <queryName Type="QString">communionservices</queryName>
          <queryText Type="QString">SELECT SUM(HolyCommunion) 
FROM rpt_service
WHERE ChurchID = $V{ChurchID}
AND DateTime BETWEEN $V{StartDate} AND $V{EndDate}

</queryText>
          <connectionName Type="QString">ChurchDB</connectionName>
        </item>
        <item ClassName="LimeReport::QueryDesc" Type="Object">
          <objectName Type="QString"></objectName>
          <queryName Type="QString">church</queryName>
          <queryText Type="QString">SELECT * FROM rpt_church_identity WHERE ID = $V{ChurchID};</queryText>
          <connectionName Type="QString">ChurchDB</connectionName>
        </item>
      </queries>
      <subqueries Type="Collection">
        <item ClassName="LimeReport::SubQueryDesc" Type="Object">
          <objectName Type="QString"></objectName>
          <queryName Type="QString">journal</queryName>
          <queryText Type="QString">SELECT *
FROM rpt_journal
WHERE ChurchID = $D{church.ID}
AND (Startdate BETWEEN $V{StartDate} AND $V{EndDate})
OR (EndDate BETWEEN $V{StartDate} AND $V{EndDate});</queryText>
          <connectionName Type="QString">ChurchDB</connectionName>
          <master Type="QString">communionservices</master>
        </item>
      </subqueries>
      <subproxies Type="Collection"/>
      <variables Type="Collection">
        <item ClassName="LimeReport::VarDesc" Type="Object">
          <objectName Type="QString"></objectName>
          <name Type="QString">ChurchID</name>
          <value Type="QString">0</value>
          <isMandatory Value="0" Type="bool"/>
          <dataType Value="0" Type="int"/>
        </item>
        <item ClassName="LimeReport::VarDesc" Type="Object">
          <objectName Type="QString"></objectName>
          <name Type="QString">StartDate</name>
          <value Type="QString">2023/1/1</value>
          <isMandatory Value="0" Type="bool"/>
          <dataType Value="5" Type="int"/>
        </item>
        <item ClassName="LimeReport::VarDesc" Type="Object">
          <objectName Type="QString"></objectName>
          <name Type="QString">EndDate</name>
          <value Type="QString">2023/3/31</value>
          <isMandatory Value="0" Type="bool"/>
          <dataType Value="5" Type="int"/>
        </item>
      </variables>
      <csvs Type="Collection"/>
    </datasourcesManager>
