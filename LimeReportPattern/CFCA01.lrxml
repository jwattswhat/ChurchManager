      <queries Type="Collection">
        <item Type="Object" ClassName="LimeReport::QueryDesc">
          <objectName Type="QString"></objectName>
          <queryName Type="QString">Church</queryName>
          <queryText Type="QString">SELECT * FROM tblChurch WHERE ID = $V{ChurchID};</queryText>
          <connectionName Type="QString">ChurchDB</connectionName>
        </item>
        <item Type="Object" ClassName="LimeReport::QueryDesc">
          <objectName Type="QString"></objectName>
          <queryName Type="QString">COALevel0</queryName>
          <queryText Type="QString">SELECT * FROM tblFund WHERE ChurchID = $V{ChurchID} AND FiscalYear = $V{FiscalYear} AND Parent is Null;</queryText>
          <connectionName Type="QString">ChurchDB</connectionName>
        </item>
      </queries>
      <subqueries Type="Collection">
        <item Type="Object" ClassName="LimeReport::SubQueryDesc">
          <objectName Type="QString"></objectName>
          <queryName Type="QString">coalevel2</queryName>
          <queryText Type="QString">SELECT * FROM tblFund WHERE ChurchID = $V{ChurchID} AND Parent = $D{COALevel1.ID};</queryText>
          <connectionName Type="QString">ChurchDB</connectionName>
          <master Type="QString">COALevel1</master>
        </item>
        <item Type="Object" ClassName="LimeReport::SubQueryDesc">
          <objectName Type="QString"></objectName>
