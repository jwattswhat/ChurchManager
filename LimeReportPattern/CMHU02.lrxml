          <queryName Type="QString">hymnusage</queryName>
          <queryText Type="QString">SELECT u.*, s.*
FROM tblHymnUsage as u
INNER JOIN tblService as s
WHERE u.ServiceID = s.ID 
AND u.HymnID = $D{hymn.ID}
AND s.ChurchID = $V{ChurchID};
</queryText>
          <connectionName Type="QString">ChurchDB</connectionName>
          <master Type="QString">hymn</master>
