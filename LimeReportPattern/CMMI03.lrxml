      <objectName Type="QString">datasources</objectName>
      <connections Type="Collection">
        <item Type="Object" ClassName="LimeReport::ConnectionDesc">
          <objectName Type="QString"></objectName>
          <name Type="QString">ChurchDB</name>
          <driver Type="QString">QMYSQL</driver>
          <databaseName Type="QString"></databaseName>
          <userName Type="QString"></userName>
          <password Type="QString" Value=""/>
          <host Type="QString"></host>
          <autoconnect Type="bool" Value="1"/>
          <keepDBCredentials Type="bool" Value="1"/>
          <port Type="int" Value="-1"/>
        </item>
      </connections>
      <queries Type="Collection">
        <item Type="Object" ClassName="LimeReport::QueryDesc">
          <objectName Type="QString"></objectName>
          <queryName Type="QString">church</queryName>
          <queryText Type="QString">SELECT * FROM rpt_church_identity WHERE ID = $V{ChurchID};</queryText>
          <connectionName Type="QString">ChurchDB</connectionName>
        </item>
        <item Type="Object" ClassName="LimeReport::QueryDesc">
          <objectName Type="QString"></objectName>
          <queryName Type="QString">person</queryName>
          <queryText Type="QString">SELECT * from rpt_membership_person 
WHERE ChurchID = $V{ChurchID} AND Member = True 
ORDER BY FamilyID, FirstName;</queryText>
          <connectionName Type="QString">ChurchDB</connectionName>
        </item>
      </queries>
      <subqueries Type="Collection">
        <item Type="Object" ClassName="LimeReport::SubQueryDesc">
          <objectName Type="QString"></objectName>
          <queryName Type="QString">contact</queryName>
          <queryText Type="QString">SELECT * FROM rpt_person_contact WHERE PersonID = $D{person.ID} AND Unlisted = False;</queryText>
          <connectionName Type="QString">ChurchDB</connectionName>
          <master Type="QString">person</master>
        </item>
        <item Type="Object" ClassName="LimeReport::SubQueryDesc">
          <objectName Type="QString"></objectName>
          <queryName Type="QString">address</queryName>
          <queryText Type="QString">SELECT * FROM rpt_person_address WHERE PersonID = $D{person.ID};</queryText>
          <connectionName Type="QString">ChurchDB</connectionName>
          <master Type="QString">person</master>
        </item>
        <item Type="Object" ClassName="LimeReport::SubQueryDesc">
          <objectName Type="QString"></objectName>
          <queryName Type="QString">familyaddress</queryName>
          <queryText Type="QString">SELECT * FROM rpt_family_address WHERE FamilyID = $D{person.FamilyID};</queryText>
          <connectionName Type="QString">ChurchDB</connectionName>
          <master Type="QString">person</master>
        </item>
        <item Type="Object" ClassName="LimeReport::SubQueryDesc">
          <objectName Type="QString"></objectName>
          <queryName Type="QString">persondate</queryName>
          <queryText Type="QString">SELECT ID,PersonID, DateType,Date,Note, TIMESTAMPDIFF(YEAR,Date,NOW()) 
 FROM rpt_person_date
WHERE PersonID = $D{person.ID}
ORDER BY DateType;</queryText>
          <connectionName Type="QString">ChurchDB</connectionName>
          <master Type="QString">person</master>
        </item>
      </subqueries>
      <subproxies Type="Collection"/>
      <variables Type="Collection">
        <item Type="Object" ClassName="LimeReport::VarDesc">
          <objectName Type="QString"></objectName>
          <name Type="QString">ChurchID</name>
          <value Type="QString">0</value>
