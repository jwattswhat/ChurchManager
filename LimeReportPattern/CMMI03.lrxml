        <item ClassName="LimeReport::QueryDesc" Type="Object">
          <objectName Type="QString"></objectName>
          <queryName Type="QString">church</queryName>
          <queryText Type="QString">SELECT * FROM tblChurch WHERE ID = $V{ChurchID};</queryText>
          <connectionName Type="QString">ChurchDB</connectionName>
        </item>
        <item ClassName="LimeReport::QueryDesc" Type="Object">
          <objectName Type="QString"></objectName>
          <queryName Type="QString">person</queryName>
          <queryText Type="QString">SELECT * from tblPerson 
WHERE ChurchID = $V{ChurchID} AND Member = True 
ORDER BY FamilyID, FirstName;</queryText>
          <connectionName Type="QString">ChurchDB</connectionName>
        </item>
      </queries>
      <subqueries Type="Collection">
        <item ClassName="LimeReport::SubQueryDesc" Type="Object">
          <objectName Type="QString"></objectName>
          <queryName Type="QString">contact</queryName>
          <queryText Type="QString">SELECT * FROM tblPersonContact WHERE PersonID = $D{person.ID} AND Unlisted = False;</queryText>
          <connectionName Type="QString">ChurchDB</connectionName>
          <master Type="QString">person</master>
        </item>
        <item ClassName="LimeReport::SubQueryDesc" Type="Object">
          <objectName Type="QString"></objectName>
          <queryName Type="QString">address</queryName>
          <queryText Type="QString">SELECT * FROM tblPersonAddress WHERE PersonID = $D{person.ID};</queryText>
          <connectionName Type="QString">ChurchDB</connectionName>
          <master Type="QString">person</master>
        </item>
        <item ClassName="LimeReport::SubQueryDesc" Type="Object">
          <objectName Type="QString"></objectName>
          <queryName Type="QString">familyaddress</queryName>
          <queryText Type="QString">SELECT * FROM tblFamilyAddress WHERE FamilyID = $D{person.FamilyID};</queryText>
          <connectionName Type="QString">ChurchDB</connectionName>
          <master Type="QString">person</master>
        </item>
        <item ClassName="LimeReport::SubQueryDesc" Type="Object">
          <objectName Type="QString"></objectName>
          <queryName Type="QString">persondate</queryName>
          <queryText Type="QString">SELECT ID,PersonID, DateType,Date,Note, TIMESTAMPDIFF(YEAR,Date,NOW()) 
 FROM tblPersonDate
WHERE PersonID = $D{person.ID}
ORDER BY DateType;</queryText>
          <connectionName Type="QString">ChurchDB</connectionName>
          <master Type="QString">person</master>
        </item>
