      <queries Type="Collection">
        <item Type="Object" ClassName="LimeReport::QueryDesc">
          <objectName Type="QString"></objectName>
          <queryName Type="QString">Church</queryName>
          <queryText Type="QString">SELECT * FROM tblChurch WHERE ID = $V{ChurchID};</queryText>
          <connectionName Type="QString">ChurchDB</connectionName>
        </item>
        <item Type="Object" ClassName="LimeReport::QueryDesc">
          <objectName Type="QString"></objectName>
          <queryName Type="QString">checkregister</queryName>
          <queryText Type="QString">SELECT CR.Date, CR.CheckNumber,VN.Name,VN.Address,VN.Address2, VN.City,VN.State,VN.Zip,CR.Amount,CR.SignedBy,CR.Note,CR.Cleared,CR.LedgerID
FROM tblCheckRegister as CR
INNER JOIN tblVendor AS VN
ON CR.VendorID = VN.ID
WHERE ChurchID = 0
ORDER BY Date DESC;</queryText>
          <connectionName Type="QString">ChurchDB</connectionName>
        </item>
      </queries>
      <subqueries Type="Collection"/>
      <subproxies Type="Collection"/>
