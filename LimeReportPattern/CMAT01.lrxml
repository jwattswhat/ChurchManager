      </connections>
      <queries Type="Collection">
        <item Type="Object" ClassName="LimeReport::QueryDesc">
          <objectName Type="QString"></objectName>
          <queryName Type="QString">church</queryName>
          <queryText Type="QString">SELECT * FROM tblChurch WHERE ID = $V{ChurchID};</queryText>
          <connectionName Type="QString">ChurchDB</connectionName>
        </item>
        <item Type="Object" ClassName="LimeReport::QueryDesc">
          <objectName Type="QString"></objectName>
          <queryName Type="QString">attendanceevent</queryName>
          <queryText Type="QString">SELECT 
MONTHNAME(IF(ae.ServiceID IS NULL, ae.DateTime, s.DateTime)) AS Month,
WEEK(IF(ae.ServiceID IS NULL, ae.DateTime, s.DateTime),2) AS Week,
ae.ID, 
ae.ServiceID, 
IF(ae.ServiceID IS NULL, ae.DateTime, s.DateTime) AS dt, 
ae.ChurchID, 
ae.Description, 
ae.AttendanceType, 
ae.CommunionOffered, 
ae.HandCount, 
ae.HandCountCommunion, 
ae.Note
FROM tblAttendanceEvent AS ae 
LEFT JOIN tblService AS s
ON s.ID = ae.ServiceID
WHERE ae.ChurchID = $V{ChurchID} 
AND IF($V{StartDate}="All",1,IF(ae.ServiceID IS NULL, ae.DateTime, s.DateTime) BETWEEN $V{StartDate} AND NOW())
AND IF($V{AttendanceType}="All", 1, ae.AttendanceType= $V{AttendanceType})
ORDER BY YEAR(dt) DESC, MONTH(dt) DESC, DAY(dt) DESC;</queryText>
          <connectionName Type="QString">ChurchDB</connectionName>
        </item>
      </queries>
      <subqueries Type="Collection">
        <item Type="Object" ClassName="LimeReport::SubQueryDesc">
          <objectName Type="QString"></objectName>
          <queryName Type="QString">attendance</queryName>
          <queryText Type="QString">SELECT p.LastName,p.FirstName,a.Communion, a.AttendanceEventID
FROM tblAttendance AS a
LEFT JOIN tblPerson AS p
ON a.PersonID = p.ID
WHERE (a.AttendanceEventID = $D{attendanceevent.ID}) AND ($V{Detail}="True")
ORDER BY LastName, FirstName</queryText>
          <connectionName Type="QString">ChurchDB</connectionName>
          <master Type="QString">attendanceevent</master>
        </item>
      </subqueries>
