        <item Type="Object" ClassName="LimeReport::QueryDesc">
          <objectName Type="QString"></objectName>
          <queryName Type="QString">church</queryName>
          <queryText Type="QString">SELECT * FROM tblChurch WHERE ID = $V{ChurchID};</queryText>
          <connectionName Type="QString">churchdb</connectionName>
        </item>
        <item Type="Object" ClassName="LimeReport::QueryDesc">
          <objectName Type="QString"></objectName>
          <queryName Type="QString">project</queryName>
          <queryText Type="QString">SELECT * FROM tblProject WHERE ChurchID = $V{ChurchID} AND Complete = $V{Complete} ORDER BY Priority, ProjectCategory,  AssignedTo, EndDate;</queryText>
          <connectionName Type="QString">churchdb</connectionName>
        </item>
      </queries>
      <subqueries Type="Collection">
        <item Type="Object" ClassName="LimeReport::SubQueryDesc">
          <objectName Type="QString"></objectName>
          <queryName Type="QString">task</queryName>
          <queryText Type="QString">SELECT * FROM tblTask WHERE ProjectID = $D{project.ID} ORDER BY Complete, StartDate;</queryText>
          <connectionName Type="QString">churchdb</connectionName>
          <master Type="QString">project</master>
        </item>
      </subqueries>
