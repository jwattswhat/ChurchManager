        <item ClassName="LimeReport::QueryDesc" Type="Object">
          <objectName Type="QString"></objectName>
          <queryName Type="QString">church</queryName>
          <queryText Type="QString">SELECT * FROM tblChurch WHERE ID = $V{churchID};</queryText>
          <connectionName Type="QString">churchdb</connectionName>
        </item>
        <item ClassName="LimeReport::QueryDesc" Type="Object">
          <objectName Type="QString"></objectName>
          <queryName Type="QString">persondates</queryName>
          <queryText Type="QString">SELECT d.DateType,d.Date, p.LastName,p.FirstName,p.Status, p.Member, TIMESTAMPDIFF(YEAR,d.Date,NOW())
FROM tblPersonDate as d 
INNER JOIN tblPerson as p ON p.ID = d.PersonID AND Member = 1
ORDER BY p.LastName, p.FirstName, d.DateType ;
</queryText>
          <connectionName Type="QString">churchdb</connectionName>
        </item>
      </queries>
      <subqueries Type="Collection"/>
      <subproxies Type="Collection"/>
