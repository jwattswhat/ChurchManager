          <queryName Type="QString">hymnal</queryName>
          <queryText Type="QString">SELECT * FROM tblHymnal WHERE ID = $D{hymn.HymnalID};</queryText>
          <connectionName Type="QString">ChurchDb</connectionName>
          <master Type="QString">hymn</master>
        </item>
        <item Type="Object" ClassName="LimeReport::SubQueryDesc">
          <objectName Type="QString"></objectName>
          <queryName Type="QString">service</queryName>
          <queryText Type="QString">SELECT * FROM tblService WHERE ID = $D{hymnusage.ServiceID} ORDER BY DateTime DESC;</queryText>
          <connectionName Type="QString">ChurchDb</connectionName>
          <master Type="QString">hymnusage</master>
        </item>
        <item Type="Object" ClassName="LimeReport::SubQueryDesc">
          <objectName Type="QString"></objectName>
          <queryName Type="QString">hymnusage</queryName>
          <queryText Type="QString">SELECT * FROM tblHymnUsage WHERE HymnID = $D{hymn.ID} ORDER BY $D{service.DateTime} DESC;</queryText>
