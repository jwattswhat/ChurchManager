{
    "frmServiceFORM": {
        "FORM": {
            "name": "frmService",
            "type": "Panel",
            "title": "frmService : Service Edit Form",
            "posch": [
                -1,
                -1
            ],
            "size": [
                1600,
                900
            ],
            "table": {
                "name": "tblService",
                "fields": [
                    "ID",
                    "ChurchID",
                    "DateTime",
                    "PropersID",
                    "LiturgicalDate",
                    "HolyCommunion",
                    "OrderofService",
                    "OSNote",
                    "PsalmorIntroit",
                    "SermonID",
                    "Bulletin",
                    "CheckListComplete",
                    "CheckList",
                    "Note"
                ],
                "orderby": "DateTime DESC"
            },
            "stylelist": [
                "CAPTION"
            ],
            "linkedform": {
                "frmOptions": {
                    "name": "frmOptions",
                    "type": "Panel",
                    "title": "frmOptions: Change Lectionary",
                    "table": {
                        "name": "tblOptions",
                        "fields": [
                            "*"
                        ],
                        "condition": "OptionFor = 'Lectionary' and OptionType = 'Current'"
                    },
                    "controls": [
                        "Update",
                        "Close"
                    ],
                    "readonlyfields": [
                        "OptionFor",
                        "OptionType"
                    ]
                },
                "frmSermon": {
                    "name": "frmSermon",
                    "title": "frmSermon - Add/Edit/Delete Sermon",
                    "type": "Panel",
                    "table": {
                        "name": "tblSermon",
                        "fields": [
                            "*"
                        ],
                        "condition": "ID = {SermonID}"
                    },
                    "controls": [
                        "Navigation",
                        "Close"
                    ]
                },
                "frmHymnUsage": {
                    "name": "frmHymnUsage",
                    "title": "frmHymnUsage - Add/Edit/Delete Hymns Used",
                    "type": "Panel",
                    "table": {
                        "name": "tblHymnUsage",
                        "fields": [
                            "ID",
                            "ChurchID",
                            "ServiceID",
                            "HymnID",
                            "UsedAs",
                            "Note"
                        ],
                        "condition": "ServiceID = {ID}"
                    },
                    "controls": [
                        "Navigation",
                        "Close"
                    ],
                    "fillonblank": [
                        "ServiceID",
                        "ID"
                    ]
                },
                "frmPropers": {
                    "name": "frmPropers",
                    "title": "frmPropers - Add/Edit/Delete Propers",
                    "type": "Panel",
                    "label": "Propers",
                    "pos": [
                        625,
                        20
                    ],
                    "table": {
                        "name": "tblPropers",
                        "fields": [
                            "*"
                        ],
                        "condition": "ID = {PropersID}"
                    },
                    "controls": [
                        "Update",
                        "Close"
                    ],
                    "readonlyfields": [
                        "Lectionary",
                        "Sort",
                        "Season",
                        "LiturgicalDate"
                    ]
                },
                "frmAltReading": {
                    "name":"frmAltReading",
                    "title":"frmAltReading - Add/Edit/Delete Alternate Readings",
                    "type": "Panel",
                    "table": {
                        "name": "tblAltReading",
                        "fields": ["*"],
                        "condition": "ServiceID = {ID}"
                    },
                    "controls": [
                        "Navigation",
                        "Close"
                    ],
                    "readonlyfields": [
                        "ServiceID"
                    ],
                    "fillonblank": [
                        "ServiceID",
                        "ID"
                    ]
                },
                "frmEditCheckList":{
                    "name":"frmEditCheckList",
                    "title":"frmEditCheckList - Add/Edit/Delete items in CheckList",
                    "type":"Panel",
                    "controls": [
                        "Navigation",
                        "Close"
                    ]
                }
            },
            "subform": {
                "frmPropers": {
                    "name": "frmPropers",
                    "title": "frmPropers",
                    "type": "StaticBox",
                    "label": "Propers",
                    "pos": [
                        625,
                        10
                    ],
                    "table": {
                        "name": "tblPropers",
                        "fields": [
                            "*"
                        ],
                        "condition": "ID = {PropersID}"
                    },
                    "controls": [],
                    "readonly": 1
                }
            }
        },
        "CONTROLS": {
            "lblLectionary": {
                "name": "lblLectionary",
                "type": "StaticText",
                "label": "Lectionary:",
                "pos": [
                    5,
                    0
                ]
            },
            "Lectionary": {
                "name": "Lectionary",
                "type": "StaticText",
                "fcolor": "Blue",
                "bcolor": "White",
                "pos": [
                    15,
                    20
                ]
            },
            "btnServiceHymns": {
